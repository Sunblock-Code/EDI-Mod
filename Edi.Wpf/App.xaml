<Application x:Class="Edi.Forms.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Edi.Forms"
             xmlns:adkeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- AvalonDock VS2013 theme. The drag/drop PREVIEW rectangle is EDI pink (PreviewBox* keys).
             The general "accent" (ControlAccent*) drives the active-pane / hovered-tab OUTLINE — keep
             that a SUBTLE slate so hovering a tab doesn't paint a harsh bright-pink box around it.
             These must live in Application scope because AvalonDock draws the drag preview in its own
             top-level OverlayWindow, which resolves theme keys against the app, not the DockingManager. -->
        <Color x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ControlAccentColorKey}">#3A4150</Color>
        <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ControlAccentBrushKey}" Color="#FF3A4150"/>
        <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=PreviewBoxBorderBrushKey}" Color="#FF2D8C"/>
        <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=PreviewBoxBackgroundBrushKey}" Color="#59FF2D8C"/>
    </Application.Resources>
</Application>
