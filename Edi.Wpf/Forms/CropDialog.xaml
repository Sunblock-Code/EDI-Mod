<Window x:Class="Edi.Forms.CropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop cover" Height="560" Width="860"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="{DynamicResource App.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,10"
                   Text="Drag the frame to position it and use the slider to resize. The frame is locked to the card's shape — that area becomes the cover."/>

        <Border Grid.Row="1" x:Name="stageHost" Background="#0E1015"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid x:Name="stage" ClipToBounds="True" SizeChanged="Stage_SizeChanged">
                <Image x:Name="img" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                <Canvas x:Name="overlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="dimTop"    Fill="#A6000000" IsHitTestVisible="False"/>
                    <Rectangle x:Name="dimBottom" Fill="#A6000000" IsHitTestVisible="False"/>
                    <Rectangle x:Name="dimLeft"   Fill="#A6000000" IsHitTestVisible="False"/>
                    <Rectangle x:Name="dimRight"  Fill="#A6000000" IsHitTestVisible="False"/>
                    <Border x:Name="cropFrame" BorderBrush="#FFFFFF" BorderThickness="2" Background="#01FFFFFF" Cursor="SizeAll"
                            MouseLeftButtonDown="Frame_MouseDown" MouseMove="Frame_MouseMove" MouseLeftButtonUp="Frame_MouseUp">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.85" Color="#000000"/>
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Frame size" VerticalAlignment="Center"
                       Foreground="{DynamicResource App.TextMuted}" Margin="0,0,10,0"/>
            <Slider Grid.Column="1" x:Name="sizeSlider" Minimum="0.2" Maximum="1" Value="1"
                    VerticalAlignment="Center" ValueChanged="SizeSlider_Changed"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="CANCEL" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="CROP &amp; SAVE" Style="{StaticResource DialogButtonAccent}" Click="Crop_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
