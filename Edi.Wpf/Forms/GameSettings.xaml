<Window x:Class="Edi.Forms.GameSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Settings"
        Icon="pack://application:,,,/Edi.ico"
        Height="884" Width="640"
        ResizeMode="CanResize"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Reusable styles for this dialog -->
            <!-- Bottom padding bumped to 14 so the LAUNCH OPTIONS section's "+ Add launch option"
                 button doesn't visually kiss the rounded corner / bottom border of the card. -->
            <Style x:Key="FieldCard" TargetType="Border">
                <Setter Property="Background"      Value="{DynamicResource App.PanelBgHi}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource App.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="6"/>
                <Setter Property="Padding"         Value="14,11,14,14"/>
            </Style>

            <!-- Distinct "identity" card (Game name + type) — elevated bg + accent outline -->
            <Style x:Key="FieldCardHi" TargetType="Border" BasedOn="{StaticResource FieldCard}">
                <Setter Property="Background"  Value="#232A3A"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
            </Style>

            <Style x:Key="FieldTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize"   Value="13"/>
            </Style>

            <Style x:Key="FieldDivider" TargetType="Border">
                <Setter Property="Height"     Value="1"/>
                <Setter Property="Background" Value="#5A6273"/>
                <Setter Property="Margin"     Value="0,8,0,10"/>
            </Style>

            <!-- Segmented EDI / Script Player selector -->
            <Style x:Key="SegmentToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="{DynamicResource App.InputBg}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,11">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"  Value="{DynamicResource App.AccentSoft}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Blue variant for the Script Player segment -->
            <Style x:Key="SegmentToggleScript" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="{DynamicResource App.InputBg}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,11">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"  Value="#14233D"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4D93FF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <!-- Top accent stripe -->
        <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource App.Accent}"/>

        <!-- Main card -->
        <Border Margin="14,16,14,72"
                Background="{DynamicResource App.PanelBg}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          RequestBringIntoView="Scroll_RequestBringIntoView">
            <Grid Margin="2,2,2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============ GAME NAME + TYPE ============ -->
                <Border Grid.Row="0" Style="{StaticResource FieldCardHi}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="GAME NAME" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource FieldDivider}"/>
                        <TextBox x:Name="txtName" Height="34" VerticalContentAlignment="Center" FontSize="13" Margin="0,1,0,2" BorderBrush="#5A6273" BorderThickness="1" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="TYPE" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" x:Name="rbTypeEdi" GroupName="GameType"
                                         Style="{StaticResource SegmentToggle}" Checked="GameType_Changed"
                                         ToolTip="A game that uses EDI directly (EdiConfig.json)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource App.Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="EDI" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="2" x:Name="rbTypeScript" GroupName="GameType"
                                         Style="{StaticResource SegmentToggleScript}" Checked="GameType_Changed"
                                         ToolTip="A game you play through a funscript player (ScriptPlayer, MultiFunPlayer…)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4D93FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Script Player" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ EDICONFIG.JSON PATH ============ -->
                <Border Grid.Row="2" Style="{StaticResource FieldCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock x:Name="lblConfigTitle" Text="EDI LOCATION  ·  EDICONFIG.JSON" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource FieldDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtConfigPath" Height="34" VerticalContentAlignment="Center" FontSize="13" Margin="0,1,0,2" BorderBrush="#5A6273" BorderThickness="1" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <Button  Grid.Column="2" Content="Browse…" Height="34" Width="92" BorderBrush="#5A6273" BorderThickness="1" Click="BrowseConfig_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ GAME EXECUTABLE (OPTIONAL) ============ -->
                <Border Grid.Row="4" Style="{StaticResource FieldCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="GAME EXECUTABLE" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource FieldDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtExePath" Height="34" VerticalContentAlignment="Center" FontSize="13" Margin="0,1,0,2" BorderBrush="#5A6273" BorderThickness="1" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <Button  Grid.Column="2" Content="Browse…" Height="34" Width="92" BorderBrush="#5A6273" BorderThickness="1" Click="BrowseExe_Click"/>
                        </Grid>

                        <!-- Extra named launch targets. The executable above is the default ("Launch Game");
                             these appear in the Launch button's dropdown, each with its own path + args. -->
                        <Border Style="{StaticResource FieldDivider}" Margin="0,12,0,0"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LAUNCH OPTIONS" Foreground="{DynamicResource App.TextMuted}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="extra targets in the Launch dropdown (the exe above is the default)"
                                       Foreground="{DynamicResource App.TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <ItemsControl x:Name="icLaunch" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132"/><ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="30" VerticalContentAlignment="Center" FontSize="12"
                                                 BorderBrush="#5A6273" BorderThickness="1" ToolTip="Label, e.g. Mod loader"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Height="30" VerticalContentAlignment="Center" FontSize="12"
                                                 BorderBrush="#5A6273" BorderThickness="1" ToolTip="Exe / file / URL to launch"
                                                 Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button  Grid.Column="4" Content="…" Width="32" Height="30" BorderBrush="#5A6273" BorderThickness="1"
                                                 Click="BrowseLaunch_Click" Tag="{Binding}" ToolTip="Browse for an exe/file"/>
                                        <TextBox Grid.Column="6" Height="30" VerticalContentAlignment="Center" FontSize="12"
                                                 BorderBrush="#5A6273" BorderThickness="1" ToolTip="Command-line arguments (optional)"
                                                 Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button  Grid.Column="8" Content="✕" Width="30" Height="30" BorderBrush="#5A6273" BorderThickness="1"
                                                 Click="RemoveLaunch_Click" Tag="{Binding}" ToolTip="Remove this launch option"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Decoupled from the rest of the StackPanel with its own margins so the button
                             stays clear of both the LAUNCH OPTIONS rows above and the rounded card edge
                             below. Combined with the FieldCard's 14px bottom padding this gives ~22px of
                             clearance to the panel border. -->
                        <Button Content="＋ Add launch option" Height="30" HorizontalAlignment="Left" Margin="0,8,0,4" Padding="14,0"
                                MinWidth="160"
                                BorderBrush="#5A6273" BorderThickness="1" Click="AddLaunch_Click"/>
                    </StackPanel>
                </Border>

                <!-- ============ GALLERY FOLDER OVERRIDE (OPTIONAL) ============ -->
                <Border Grid.Row="6" Style="{StaticResource FieldCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                <TextBlock x:Name="lblGalleryTitle" Text="GALLERY FOLDER" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="lblGalleryHint" Text="defaults to  .\Gallery  next to EdiConfig.json"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource FieldDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtGalleryPath" Height="34" VerticalContentAlignment="Center" FontSize="13" Margin="0,1,0,2" BorderBrush="#5A6273" BorderThickness="1" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <Button  Grid.Column="2" Content="Browse…" Height="34" Width="92" BorderBrush="#5A6273" BorderThickness="1" Click="BrowseGallery_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ INFO LOCATION (OPTIONAL) ============ -->
                <Border Grid.Row="8" Style="{StaticResource FieldCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                <TextBlock Text="INFO LOCATION" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="a .txt / .md / .pdf shown in the Info tab"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource FieldDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtInfoPath" Height="34" VerticalContentAlignment="Center" FontSize="13" Margin="0,1,0,2" BorderBrush="#5A6273" BorderThickness="1" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <Button  Grid.Column="2" Content="Browse…" Height="34" Width="92" BorderBrush="#5A6273" BorderThickness="1" Click="BrowseInfo_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ BANNER (OPTIONAL) ============ -->
                <Border Grid.Row="10" Style="{StaticResource FieldCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                <TextBlock Text="BANNER" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="shown behind the game card"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource FieldDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtImagePath" Height="34" VerticalContentAlignment="Center" FontSize="13" Margin="0,1,0,2" BorderBrush="#5A6273" BorderThickness="1" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextChanged="ImagePath_TextChanged"/>
                            <Button  Grid.Column="2" Content="Browse…" Height="34" Width="92" BorderBrush="#5A6273" BorderThickness="1" Click="BrowseImage_Click"/>
                        </Grid>

                        <!-- Banner preview — right-click for options (search / file / URL / crop / clear) -->
                        <Border x:Name="coverPreview" Height="110" Margin="0,10,0,0" CornerRadius="4"
                                Background="{DynamicResource App.InputBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                ClipToBounds="True" Cursor="Hand">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Crop banner…" Click="CropCover_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE123;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Search online…" Click="CoverSearch_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Set banner from file…" Click="BrowseImage_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Set banner from URL…" Click="CoverUrl_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Clear banner" Click="ClearCover_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Image x:Name="imgPreview" Stretch="UniformToFill"/>
                                <TextBlock x:Name="lblNoCover" Text="No banner — right-click for options"
                                           Foreground="{DynamicResource App.TextMuted}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Visible quick actions (also available via right-click) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                    <Button Width="30" Height="26" Margin="0,0,4,0" Click="CoverSearch_Click" ToolTip="Search online">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Width="30" Height="26" Margin="0,0,4,0" Click="CropCover_Click" ToolTip="Adjust crop">
                                        <TextBlock Text="&#xE123;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Width="30" Height="26" Click="ClearCover_Click" ToolTip="Clear">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFFFFF"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Action bar -->
        <Grid VerticalAlignment="Bottom" Height="52" Margin="14,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnLaunch"
                    Style="{StaticResource AccentButton}"
                    Height="38" Width="150"
                    FontWeight="SemiBold"
                    Click="LaunchGame_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LAUNCH GAME" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnDelete" Content="DELETE" Style="{StaticResource DialogButton}"
                        Click="Delete_Click" Foreground="#FF5C7A" BorderBrush="#FF5C7A"/>
                <Button x:Name="btnCancel" Content="CANCEL" Style="{StaticResource DialogButton}"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="btnSave"   Content="SAVE"   Style="{StaticResource DialogButtonAccent}"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
