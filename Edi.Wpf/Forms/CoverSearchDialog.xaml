<Window x:Class="Edi.Forms.CoverSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find cover"
        Icon="pack://application:,,,/Edi.ico"
        Height="640" Width="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Top accent stripe -->
        <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource App.Accent}"/>

        <Grid Margin="14,16,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0 search row -->
                <RowDefinition Height="Auto"/>   <!-- 1 hint -->
                <RowDefinition Height="*"/>      <!-- 2 results -->
                <RowDefinition Height="Auto"/>   <!-- 3 status -->
                <RowDefinition Height="Auto"/>   <!-- 4 buttons -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="txtQuery" Height="34" VerticalContentAlignment="Center" FontSize="13"
                         KeyDown="Query_KeyDown"/>
                <Button Grid.Column="2" x:Name="btnSearch" Content="Search" Height="34" Width="96"
                        Style="{StaticResource AccentButton}" Click="Search_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,8,2,10"
                       Text="Type a game name to search F95zone, DLsite &amp; itch.io, or paste a page link. Click a match to see all its images, then pick one and Use."/>

            <Border Grid.Row="2" Background="{DynamicResource App.InputBg}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1" CornerRadius="4">
                <ListBox x:Name="lstResults" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="Results_SelectionChanged"
                         MouseDoubleClick="Results_DoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{DynamicResource App.PanelBgHi}"
                                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                                CornerRadius="6" Padding="4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.RowSelect}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="150">
                                <Border Height="150" Background="#11141B" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource App.TextMuted}"
                                           FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="3" x:Name="lblStatus" Foreground="{DynamicResource App.TextMuted}"
                       FontSize="12" Margin="2,10,2,0" TextWrapping="Wrap"/>

            <Border Grid.Row="4" Background="{DynamicResource App.HeaderBg}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,1,0,0" Margin="-14,12,-14,-12" Padding="14,12">
                <DockPanel LastChildFill="False">
                    <Button x:Name="btnBack" DockPanel.Dock="Left" Content="← Back to results"
                            Style="{StaticResource DialogButton}" Click="Back_Click" Visibility="Collapsed"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
                        <Button x:Name="btnUse" Content="Use" Style="{StaticResource DialogButtonAccent}" Click="Use_Click" IsEnabled="False"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
