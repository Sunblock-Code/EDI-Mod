<Window x:Class="Edi.Forms.AddGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Game" SizeToContent="Height" MinHeight="262" Width="540"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize"   Value="12"/>
            </Style>

            <Style x:Key="SegmentToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="{DynamicResource App.InputBg}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,11">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"  Value="{DynamicResource App.AccentSoft}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource App.Accent}"/>
        <Grid Margin="18,18,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="TYPE" Style="{StaticResource FieldTitle}"/>
            <Grid Grid.Row="1" Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" x:Name="rbTypeEdi" GroupName="GameType" IsChecked="True"
                             Checked="GameType_Changed" Style="{StaticResource SegmentToggle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF2D8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="EDI" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="2" x:Name="rbTypeScript" GroupName="GameType"
                             Checked="GameType_Changed" Style="{StaticResource SegmentToggle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4D93FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SCRIPT PLAYER" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <TextBlock Grid.Row="2" Text="GAME FOLDER" Style="{StaticResource FieldTitle}"/>
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="txtFolder" Height="34" VerticalContentAlignment="Center" FontSize="13"/>
                <Button Grid.Column="2" Content="Browse…" Height="34" Width="92"
                        BorderBrush="#5A6273" BorderThickness="1" Click="Browse_Click"/>
            </Grid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="CANCEL" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="ADD"    x:Name="btnAdd" Style="{StaticResource DialogButtonAccent}" Click="Add_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
