<UserControl x:Class="Edi.Forms.FmConverterControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- pink → cyan brush used by the cool title + accent line + icon -->
            <LinearGradientBrush x:Key="FmTitleBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF74B7" Offset="0"/>
                <GradientStop Color="#FF2D8C" Offset="0.5"/>
                <GradientStop Color="#00E5FF" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="Hdr" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="Margin"     Value="0,0,0,8"/>
            </Style>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize"   Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"   Value="{DynamicResource App.InputBg}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource App.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding"      Value="14"/>
                <Setter Property="Margin"       Value="0,0,0,12"/>
            </Style>
            <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="86"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="30"/>
            </Style>
            <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background"  Value="{DynamicResource App.Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                <Setter Property="Foreground"  Value="#FFFFFF"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Height"      Value="34"/>
                <Setter Property="Padding"     Value="14,0"/>
            </Style>
            <Style x:Key="OptCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="Margin"     Value="0,4,0,4"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- cool title header -->
            <RowDefinition Height="2"/>      <!-- gradient accent line -->
            <RowDefinition Height="*"/>      <!-- scroll body -->
            <RowDefinition Height="Auto"/>   <!-- status + convert -->
        </Grid.RowDefinitions>

        <!-- ===== Cool title: icon tile + gradient wordmark ===== -->
        <Border Grid.Row="0" Padding="16,13">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2A0E1C" Offset="0"/>
                    <GradientStop Color="#16181F" Offset="0.7"/>
                    <GradientStop Color="#0C1A22" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="#0E1015" VerticalAlignment="Center" Margin="0,0,13,0"
                        BorderBrush="#33FF2D8C" BorderThickness="1">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                               Foreground="{StaticResource FmTitleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FUCK MACHINE CONVERTER" FontSize="16.5" FontWeight="Bold"
                               Foreground="{StaticResource FmTitleBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF2D8C" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="ROTARY  ·  stroke → power-level" Foreground="{DynamicResource App.TextMuted}"
                               FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource FmTitleBrush}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,12,18,6">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource App.TextMuted}" FontSize="11.5"
                           Text="Converts a stroke funscript into device POWER LEVELS for a rotary machine (speed-controlled). It measures each thrust's cycle time and maps it to your device's RPM range. The original is never changed — converted scripts are saved into a gallery subfolder named after the device (e.g. Gallery\Hismith), which EDI loads as a selectable per-device variant."/>

                <!-- ===== Device profile ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hdr}" Text="Device profile (RPM range)"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="cmbProfile" Height="32" VerticalContentAlignment="Center"
                                      SelectionChanged="Profile_SelectionChanged"/>
                            <Button Grid.Column="1" x:Name="btnProfNew"    Content="New"    Width="58" Height="32" Margin="6,0,0,0" Click="ProfNew_Click"/>
                            <Button Grid.Column="2" x:Name="btnProfSave"   Content="Save"   Width="58" Height="32" Margin="6,0,0,0" Click="ProfSave_Click"/>
                            <Button Grid.Column="3" x:Name="btnProfRemove" Content="Remove" Width="68" Height="32" Margin="6,0,0,0" Click="ProfRemove_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Name" Margin="0,0,8,0"/>
                            <TextBox   Grid.Column="1" x:Name="txtProfName" Height="30" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Lbl}" Text="Min RPM (1%)" Margin="14,0,8,0"/>
                            <TextBox   Grid.Column="3" x:Name="txtMinRpm" Style="{StaticResource NumBox}"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource Lbl}" Text="Max RPM (100%)" Margin="14,0,8,0"/>
                            <TextBox   Grid.Column="5" x:Name="txtMaxRpm" Style="{StaticResource NumBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Calibration (optional) ===== -->
                <Expander x:Name="expCal" Header="Calibration helpers (optional)" Foreground="{DynamicResource App.Text}" Margin="0,0,0,12">
                    <StackPanel Margin="0,8,0,0">
                        <!-- Unit converter -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hdr}" Text="Unit converter"/>
                                <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Time a known number of machine cycles at a fixed power level, enter cycles + seconds, then read the RPM. Or convert between any of these."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Cycles" Margin="0,0,6,0"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtUcCycles" Style="{StaticResource NumBox}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Seconds" Margin="0,0,6,0"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtUcSeconds" Style="{StaticResource NumBox}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="RPM" Margin="0,0,6,0"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtUcRpm" Style="{StaticResource NumBox}"/>

                                    <StackPanel Grid.Row="0" Grid.RowSpan="5" Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Computed:"/>
                                        <TextBlock x:Name="lblUcCycleMs" Foreground="{DynamicResource App.Text}" Margin="0,4,0,0" Text="Cycle: —"/>
                                        <TextBlock x:Name="lblUcRpm"     Foreground="{DynamicResource App.Text}" Margin="0,2,0,0" Text="RPM: —"/>
                                        <TextBlock x:Name="lblUcPower"   Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" Margin="0,2,0,0" Text="Power: —"/>
                                        <Button Content="Compute" Width="92" Height="28" HorizontalAlignment="Left" Margin="0,8,0,0" Click="UcCompute_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Min/Max RPM estimator -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hdr}" Text="Min / Max RPM estimator"/>
                                <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Add measurements (set a power %, measure the RPM with the unit converter above). 2+ points fit a line to estimate RPM at 1% and 100%."/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Power %"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Lbl}" Text="RPM"/>
                                </Grid>
                                <ItemsControl x:Name="icMeasure">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Width="74" Height="28" HorizontalContentAlignment="Right"
                                                         Text="{Binding PowerText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="1" Width="94" Height="28" HorizontalContentAlignment="Right"
                                                         Text="{Binding RpmText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="2" Content="✕" Width="28" Height="28" Click="MeasureRemove_Click"
                                                        Tag="{Binding}" ToolTip="Remove measurement"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Add measurement" Height="30" Padding="12,0" Click="MeasureAdd_Click"/>
                                    <Button Content="Estimate" Height="30" Padding="12,0" Margin="8,0,0,0" Click="Estimate_Click"/>
                                    <TextBlock x:Name="lblEstimate" Style="{StaticResource Lbl}" Margin="12,0,0,0" Text="—"/>
                                    <Button x:Name="btnApplyEstimate" Content="Apply to profile" Height="30" Padding="12,0" Margin="8,0,0,0"
                                            Click="ApplyEstimate_Click" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- ===== Conversion options ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hdr}" Text="Conversion options"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="chkSinglePeaks"   Style="{StaticResource OptCheck}" Content="Record power on single peaks"/>
                                <CheckBox x:Name="chkSingleTroughs" Style="{StaticResource OptCheck}" Content="Record power on single troughs"/>
                                <CheckBox x:Name="chkPeakSeries"    Style="{StaticResource OptCheck}" Content="Record power on peak series"/>
                                <CheckBox x:Name="chkTroughSeries"  Style="{StaticResource OptCheck}" Content="Record power on trough series"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="chkIgnore0"       Style="{StaticResource OptCheck}" Content="Leave 0-position runs at 0"/>
                                <CheckBox x:Name="chkDropoff"       Style="{StaticResource OptCheck}" Content="Power drop-off during pauses"/>
                                <StackPanel Orientation="Horizontal" Margin="22,2,0,4">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Drop-off offset (ms)" Margin="0,0,8,0"/>
                                    <TextBox x:Name="txtDropoffMs" Width="60" Height="28" HorizontalContentAlignment="Right"/>
                                </StackPanel>
                                <CheckBox x:Name="chkStep"          Style="{StaticResource OptCheck}" Content="Override power step size"/>
                                <StackPanel Orientation="Horizontal" Margin="22,2,0,4">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Step size" Margin="0,0,8,0"/>
                                    <TextBox x:Name="txtStep" Width="60" Height="28" HorizontalContentAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Source & output ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hdr}" Text="Source script → FM variant"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Source" Margin="0,0,8,0"/>
                            <ComboBox  Grid.Column="1" x:Name="cmbSource" Height="32" VerticalContentAlignment="Center"
                                       SelectionChanged="Source_SelectionChanged"/>
                            <Button    Grid.Column="2" Content="Browse…" Height="32" Padding="12,0" Margin="6,0,0,0" Click="Browse_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Save to subfolder" Margin="0,0,8,0"/>
                            <TextBox   Grid.Column="1" x:Name="txtVariant" Width="140" Height="30" VerticalContentAlignment="Center"
                                       TextChanged="Variant_TextChanged"/>
                            <TextBlock Grid.Column="2" x:Name="lblOutPath" Style="{StaticResource Lbl}" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" Text=""/>
                        </Grid>
                        <TextBlock x:Name="lblSourceInfo" Style="{StaticResource Lbl}" Margin="0,8,0,0" Text=""/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Status + convert ===== -->
        <Border Grid.Row="3" Background="{DynamicResource App.InputBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.TextMuted}" Text="Pick a source script and a device profile, then convert."/>
                <Button Grid.Column="1" x:Name="btnConvert" Style="{StaticResource AccentBtn}" Content="Convert &amp; Save" Click="Convert_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
