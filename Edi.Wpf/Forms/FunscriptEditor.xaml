<Window x:Class="Edi.Forms.FunscriptEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funscript Editor"
        Icon="pack://application:,,,/Edi.ico"
        Height="640" Width="1120"
        MinHeight="500" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Red scrollbar (matches the accent theme) -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="3" Background="{DynamicResource App.Accent}" Margin="4,0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldCard" TargetType="Border">
                <Setter Property="Background"      Value="{DynamicResource App.PanelBgHi}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource App.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="6"/>
                <Setter Property="Padding"         Value="12,10"/>
            </Style>

            <Style x:Key="FieldTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize"   Value="13"/>
            </Style>

            <Style x:Key="FieldDivider" TargetType="Border">
                <Setter Property="Height"     Value="1"/>
                <Setter Property="Background" Value="#5A6273"/>
                <Setter Property="Margin"     Value="0,8,0,10"/>
            </Style>

            <Style x:Key="FileItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="Padding"    Value="10,7"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.RowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.RowSelect}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.Accent}"/>

        <!-- Main content: file list + preview/controls -->
        <Grid Grid.Row="1" Margin="12,12,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colFiles" Width="320" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Drag handle to resize the file list -->
            <GridSplitter Grid.Column="1" Width="8"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" Panel.ZIndex="10"
                          ToolTip="Drag to resize the file list"/>

            <!-- File list -->
            <Border Grid.Column="0" Style="{StaticResource FieldCard}">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="FUNSCRIPTS" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Width="1" Background="#5A6273" Margin="10,1,10,1"/>
                        <TextBlock x:Name="lblGalleryLock" DockPanel.Dock="Left" Text="&#x1F512;" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" Visibility="Hidden"
                                   MouseLeftButtonDown="Lock_Click"
                                   ToolTip="Locked gallery — click to unlock before saving over it"/>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run x:Name="runGalleryPrefix" Text="Gallery/" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/><Hyperlink x:Name="lnkVariant" Click="Variant_Click" TextDecorations="{x:Null}" Foreground="{DynamicResource App.Accent}" Cursor="Hand" ToolTip="Click to switch variant"><Run x:Name="runVariant" Foreground="{DynamicResource App.Accent}" FontSize="14" FontWeight="SemiBold"/></Hyperlink></TextBlock>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource FieldDivider}"/>
                    <TextBlock x:Name="lblFileCount" DockPanel.Dock="Bottom" Foreground="{DynamicResource App.TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                    <Grid>
                        <ListBox x:Name="lstFiles"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource FileItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="lstFiles_SelectionChanged"/>
                        <TextBlock x:Name="lblNoFiles" Visibility="Collapsed"
                                   Text="No .funscript files found in this gallery."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Top" Margin="6,12,6,0"
                                   Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Preview + controls -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview canvas -->
                <Border Grid.Row="0" Style="{StaticResource FieldCard}" Padding="12,10,12,10">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="PREVIEW" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                <Border Width="1" Background="#5A6273" Margin="10,2,10,2"/>
                                <TextBlock x:Name="lblSelectedPath"
                                           Foreground="{DynamicResource App.TextMuted}" FontSize="12"
                                           VerticalAlignment="Center"
                                           MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblTimeRange" Foreground="{DynamicResource App.TextMuted}" FontSize="11" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Style="{StaticResource FieldDivider}"/>
                        <Border Background="{DynamicResource App.InputBg}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Gridlines -->
                                <Canvas x:Name="canvasGrid" IsHitTestVisible="False"/>
                                <!-- Waveforms (+ draggable lock line) -->
                                <Canvas x:Name="canvasPreview" Background="Transparent"
                                        SizeChanged="canvasPreview_SizeChanged"
                                        MouseLeftButtonDown="canvasPreview_MouseLeftButtonDown"
                                        MouseMove="canvasPreview_MouseMove"
                                        MouseLeftButtonUp="canvasPreview_MouseLeftButtonUp"/>
                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,8,0">
                                    <Border Width="14" Height="2" Background="{DynamicResource App.BorderStrong}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Original" Foreground="{DynamicResource App.TextMuted}" FontSize="11" Margin="0,0,10,0"/>
                                    <Border Width="14" Height="2" Background="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Modified" Foreground="{DynamicResource App.Text}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Controls -->
                <Border Grid.Row="2" Style="{StaticResource FieldCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="TRANSFORM" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                            <CheckBox DockPanel.Dock="Right" x:Name="chkIndividual" Style="{StaticResource ToggleSwitch}" Content="Individual" VerticalAlignment="Center"
                                      ToolTip="On: each script keeps its own edit. Off: the same edit applies to every script."/>
                            <TextBlock DockPanel.Dock="Right" x:Name="lblModeHint" Text="same edit on every script"
                                       Foreground="{DynamicResource App.TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                        <Border Style="{StaticResource FieldDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Stroke Min" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center"/>
                            <Slider    Grid.Row="0" Grid.Column="1" x:Name="sliderMin" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblMin" Text="0%" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stroke Max" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center"/>
                            <Slider    Grid.Row="1" Grid.Column="1" x:Name="sliderMax" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lblMax" Text="100%" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Intensity" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center"/>
                            <Slider    Grid.Row="2" Grid.Column="1" x:Name="sliderIntensity" Minimum="10" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lblIntensity" Text="100%" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Vibrate" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center"
                                       ToolTip="Insert this many oscillating points between each pair (0 = off)"/>
                            <Slider    Grid.Row="3" Grid.Column="1" x:Name="sliderVibrate" Minimum="0" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="lblVibrate" Text="off" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                        </Grid>

                        <!-- Divider under Intensity -->
                        <Border Style="{StaticResource FieldDivider}"/>

                        <!-- Toggles: locks on the left, invert far right -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="chkLock" Content="Lock below" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblLock" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,22,0"/>
                                <CheckBox x:Name="chkLockAbove" Content="Lock above" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblLockAbove" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="chkInvert" Content="Invert (flip up ⇄ down)" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom action bar -->
        <Grid Grid.Row="2" Margin="14,4,14,12" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="lblStatus"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource App.TextMuted}"
                       Text="Select a funscript to preview"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Save Gallery as" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbSaveTarget" Width="150" Height="38"
                          VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Margin="0,0,8,0" SelectionChanged="cmbSaveTarget_SelectionChanged"
                          ToolTip="Save to a new gallery or overwrite an existing one"/>
                <TextBox x:Name="txtNewGalleryName" Width="150" Height="38"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Margin="0,0,14,0"
                         ToolTip="New gallery folder name"/>
                <Button x:Name="btnReset" Content="RESET" Style="{StaticResource DialogButton}" Click="Reset_Click"/>
                <Button x:Name="btnClose" Content="CLOSE" Style="{StaticResource DialogButton}" Click="Close_Click" IsCancel="True"/>
                <Button x:Name="btnSave"  Style="{StaticResource DialogButtonAccent}" Click="SaveGallery_Click" Width="180">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSaveBtn" Text="SAVE ALL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
