<Window x:Class="Edi.Forms.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDI"
        Icon="pack://application:,,,/Edi.ico"
        SizeToContent="Height" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Top accent stripe -->
        <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource App.Accent}"/>

        <Grid Margin="0,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Message -->
            <DockPanel Grid.Row="0" Margin="22,22,22,16">
                <TextBlock x:Name="icon" DockPanel.Dock="Left" Text="&#xE897;"
                           FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{DynamicResource App.Accent}"
                           VerticalAlignment="Top" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock x:Name="lblHeader" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="lblBody" Foreground="{DynamicResource App.TextMuted}"
                               FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    <TextBox x:Name="txtInput" Visibility="Collapsed" Height="32" Margin="0,12,0,0"
                             VerticalContentAlignment="Center" FontSize="13"/>
                </StackPanel>
            </DockPanel>

            <!-- Action bar -->
            <Border Grid.Row="1" Background="{DynamicResource App.HeaderBg}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                    Padding="14,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnNo"  Content="No"  Style="{StaticResource DialogButton}"       Click="No_Click"  IsCancel="True"/>
                    <Button x:Name="btnYes" Content="Yes" Style="{StaticResource DialogButtonAccent}" Click="Yes_Click" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
