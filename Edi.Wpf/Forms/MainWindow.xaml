<Window x:Class="Edi.Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Edi.Forms"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:adkeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="EDI"
        Height="880" Width="960"
        MinHeight="430" MinWidth="660"
        ResizeMode="CanResize"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToReadyIconConverter x:Key="BoolToReadyIconConverter"/>
            <local:GameIconConverter x:Key="GameIconConverter"/>
            <local:GameCoverConverter x:Key="GameCoverConverter"/>
            <local:GameHasCoverConverter x:Key="GameHasCoverConverter"/>
            <local:RoundedClipConverter x:Key="RoundedClipConverter"/>
            <local:IntensityFillConverter x:Key="IntensityFillConverter"/>
            <sys:Double x:Key="Slider.FillClipRadius">11</sys:Double>   <!-- live-edit bar fill: rounded clip to the pill -->

            <!-- Live, user-adjustable card metrics (Settings sliders update these) -->
            <sys:Double x:Key="Card.MinHeight">44</sys:Double>
            <sys:Double x:Key="Card.BlurRadius">18</sys:Double>
            <CornerRadius x:Key="Card.BadgeRadius">11</CornerRadius>   <!-- Pill; Rounded=4, Square=0 -->
            <sys:Double x:Key="Card.CoverOpacity">1</sys:Double>      <!-- Cover style=1, Solid style=0 -->
            <sys:Double x:Key="Card.ScrimOpacity">0.7</sys:Double>    <!-- darkness of the scrim over art -->
            <TextAlignment x:Key="Card.TitleAlign">Left</TextAlignment>   <!-- card title align; also set from code -->
            <VerticalAlignment x:Key="Card.TitleVAlign">Center</VerticalAlignment>   <!-- card title vertical placement: Top/Center/Bottom -->
            <sys:Double x:Key="Card.TitleSize">15</sys:Double>        <!-- card title font size -->
            <CornerRadius x:Key="Card.IconRadius">0</CornerRadius>    <!-- game icon shape: 0=square, ~10=rounded, half=circle -->
            <sys:Double x:Key="Card.IconSize">44</sys:Double>        <!-- icon box size (square/rounded = card height; circle = inset) -->
            <Thickness x:Key="Card.IconMargin">0</Thickness>        <!-- icon inset (circle is inset so it never clips) -->
            <CornerRadius x:Key="Card.Corner">8</CornerRadius>        <!-- card corner roundness -->
            <Thickness x:Key="Card.OutlineThickness">1</Thickness>    <!-- card outline thickness -->
            <!-- Selected-game-card look (independent of the card outline above; set by ApplySelStyle) -->
            <Thickness x:Key="Sel.BorderThickness">2.5</Thickness>    <!-- accent selection border -->
            <sys:Double x:Key="Sel.BarWidth">0</sys:Double>          <!-- left accent bar width (Bar style) -->
            <sys:Double x:Key="Sel.GlowBlur">18</sys:Double>         <!-- selection glow blur -->
            <sys:Double x:Key="Sel.GlowOpacity">0.9</sys:Double>     <!-- selection glow opacity -->
            <SolidColorBrush x:Key="Sel.FillBrush" Color="#26FF3D93"/>   <!-- selected-card background tint -->


            <!-- Compact segmented toggle for the card-options popup (Badge shape / Card style) -->
            <Style x:Key="CardSegToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Margin"     Value="2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="{DynamicResource App.InputBg}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="5" Padding="0,5" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"  Value="{DynamicResource App.AccentSoft}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Momentary segmented button (blur-style quick presets) -->
            <Style x:Key="CardSegButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Margin"     Value="2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource App.InputBg}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="5" Padding="0,5" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background"  Value="{DynamicResource App.AccentSoft}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Cool glowing intensity slider with the % shown inside the bar -->
            <!-- Live-edit fill bar (0-100%). Value-proportional fill + centered %, plus a slim
                 draggable handle that sits at the fill edge. Click anywhere to set, or grab the
                 handle to drag. Fill colour = Foreground, so each bar can be tinted (Intensity =
                 pink default, Vibration = cyan via a per-instance Foreground). -->
            <Style x:Key="IntensitySlider" TargetType="Slider">
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="SmallChange" Value="1"/>
                <Setter Property="LargeChange" Value="10"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Foreground">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C71F6E" Offset="0"/>
                            <GradientStop Color="#FF2D8C" Offset="0.55"/>
                            <GradientStop Color="#FF74B7" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <!-- track background (pill) -->
                                <Border CornerRadius="13" Height="26"
                                        Background="{DynamicResource App.InputBg}"
                                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1"/>
                                <!-- The Track lays out the fill, handle and remainder TOGETHER, so the handle
                                     always sits exactly at the fill edge (no drift between fill and handle).
                                     DecreaseRepeatButton = coloured fill; Thumb = handle; IncreaseRepeatButton
                                     = empty remainder (shows the pill background). -->
                                <Track x:Name="PART_Track" Height="26">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                                                            CornerRadius="11,0,0,11" Margin="2,2,0,2"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <!-- 12px grab area; slim white handle flush at the fill edge -->
                                        <Thumb Width="12">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent">
                                                        <Border Width="6" Height="22" CornerRadius="3" Background="#FFFFFFFF"
                                                                BorderBrush="#55000000" BorderThickness="1" HorizontalAlignment="Left">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
                                                            </Border.Effect>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <local:ProgramIconConverter x:Key="ProgramIconConverter"/>

            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.PanelBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>

            <!-- Shared pink gradient for top-bar pill icons (the Funscript Player look) -->
            <LinearGradientBrush x:Key="PillIcon" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF74B7" Offset="0"/>
                <GradientStop Color="#FF2D8C" Offset="1"/>
            </LinearGradientBrush>

            <!-- Top-bar launcher pills (API Docs / Intiface) — rounded square with a hover color shift -->
            <Style x:Key="LauncherPill" TargetType="Border">
                <Setter Property="Background" Value="#1B1E27"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!-- Fixed height so EVERY pill is identical regardless of content (icon, 1 or 2
                     text lines, URL shown or hidden). Content vertically centers inside it. -->
                <Setter Property="Height" Value="50"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2A3142"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>

            <!-- Blue button (used for "Modify Scripts") -->
            <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background"  Value="#2D7DF6"/>
                <Setter Property="BorderBrush" Value="#2D7DF6"/>
                <Setter Property="Foreground"  Value="#FFFFFF"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"  Value="#4D93FF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4D93FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background"  Value="#1E6AD6"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1E6AD6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact tabs for the Settings popup (underline-style, dark theme) -->
            <Style x:Key="SettingsTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                                    <TabPanel IsItemsHost="True" HorizontalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filled-pink action button used for each donation option in the Support popup -->
            <Style x:Key="DonateButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background"  Value="#E0277A"/>
                <Setter Property="BorderBrush" Value="#E0277A"/>
                <Setter Property="Foreground"  Value="#FFFFFF"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="Height"      Value="34"/>
                <Setter Property="Padding"     Value="12,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"  Value="#F23E92"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#F23E92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background"  Value="#C41E68"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#C41E68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Per-link donation button (display mode); auto-hides when its URL is blank -->
            <Style x:Key="DonateLinkButton" TargetType="Button" BasedOn="{StaticResource DonateButton}">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding Url}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Outlined-pink "Support" button that lives in the top-right header tools -->
            <Style x:Key="SupportHeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#E0277A"/>
                <Setter Property="Foreground"  Value="#FF74B7"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="12"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="Height"      Value="32"/>
                <Setter Property="Padding"     Value="10,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#33E0277A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#55E0277A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="bd" Background="Transparent" Padding="16,7" Margin="2,0"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,2" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.RowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>      <!-- Accent stripe -->
            <RowDefinition Height="Auto"/>   <!-- Quick-access bar -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== Top accent stripe ===== -->
        <Border Grid.Row="0" Background="{DynamicResource App.Accent}"/>

        <!-- ===== Quick-access bar (API docs + program launchers) ===== -->
        <Border Grid.Row="1" Background="{DynamicResource App.HeaderBg}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">

                <!-- Right-aligned tools at the very top-right: Support + Settings + View + Open Config -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Support / donate: opens a popup crediting the original EDI author and listing donation options -->
                    <Button x:Name="btnSupport" Click="Support_Click" Style="{StaticResource SupportHeaderButton}"
                            ToolTip="Support this mod &#8226; credits the original EDI creator">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF74B7"
                                       VerticalAlignment="Center" Margin="0,0,7,0" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="Support" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSettings" Click="SettingsButton_Click" Width="36" Height="32" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1" ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" TextOptions.TextRenderingMode="ClearType"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="btnOpenConfigTop" Click="btnOpenOutput_Click" Width="36" Height="32" Margin="6,0,0,0"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1" ToolTip="Open Config Directory">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" TextOptions.TextRenderingMode="ClearType"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- View popup (card height + cover blur). Opened by the eye button next to the
                         GAME edit cog; PlacementTarget is set in code to whichever eye was clicked. -->
                    <Popup x:Name="ViewPopup"
                           Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="0" VerticalOffset="4" Closed="ViewPopup_Closed">
                        <Border Background="{DynamicResource App.PanelBgHi}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Width="300" Margin="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="#FF000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Game cards" Foreground="{DynamicResource App.Text}"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Height" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <Slider Grid.Column="1" x:Name="sliderCardHeight" Minimum="32" Maximum="120" Margin="6,0" VerticalAlignment="Center"
                                            ValueChanged="CardHeight_Changed"/>
                                    <TextBlock Grid.Column="2" x:Name="lblCardHeight" VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cover blur" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <Slider Grid.Column="1" x:Name="sliderCoverBlur" Minimum="0" Maximum="40" Margin="6,0" VerticalAlignment="Center"
                                            ValueChanged="CoverBlur_Changed"/>
                                    <TextBlock Grid.Column="2" x:Name="lblCoverBlur" VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Cover darkness (scrim over the art) -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Darkness" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <Slider Grid.Column="1" x:Name="sliderDarkness" Minimum="0" Maximum="85" Margin="6,0" VerticalAlignment="Center"
                                            ValueChanged="Darkness_Changed"/>
                                    <TextBlock Grid.Column="2" x:Name="lblDarkness" VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Blur-style quick presets (set blur + darkness together) -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Blur style" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                                        <RadioButton x:Name="rbBlurSoft"  GroupName="BlurStyle" Style="{StaticResource CardSegToggle}" Tag="Soft"    Content="Soft"  Checked="BlurStyle_Checked"/>
                                        <RadioButton x:Name="rbBlurHeavy" GroupName="BlurStyle" Style="{StaticResource CardSegToggle}" Tag="Heavy"   Content="Heavy" Checked="BlurStyle_Checked"/>
                                        <RadioButton x:Name="rbBlurFrost" GroupName="BlurStyle" Style="{StaticResource CardSegToggle}" Tag="Frosted" Content="Frost" Checked="BlurStyle_Checked"/>
                                        <RadioButton x:Name="rbBlurSharp" GroupName="BlurStyle" Style="{StaticResource CardSegToggle}" Tag="Sharp"   Content="Sharp" Checked="BlurStyle_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Badge shape: Pill / Rounded / Square -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Badge" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                        <RadioButton x:Name="rbBadgePill"    GroupName="BadgeShape" Style="{StaticResource CardSegToggle}" Tag="Pill"    Content="Pill"    Checked="BadgeShape_Checked"/>
                                        <RadioButton x:Name="rbBadgeRounded" GroupName="BadgeShape" Style="{StaticResource CardSegToggle}" Tag="Rounded" Content="Rounded" Checked="BadgeShape_Checked"/>
                                        <RadioButton x:Name="rbBadgeSquare"  GroupName="BadgeShape" Style="{StaticResource CardSegToggle}" Tag="Square"  Content="Square"  Checked="BadgeShape_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Card style: Cover (blurred art) / Solid (no art) -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Card style" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="2">
                                        <RadioButton x:Name="rbStyleCover" GroupName="CardStyle" Style="{StaticResource CardSegToggle}" Tag="Cover" Content="Cover" Checked="CardStyle_Checked"/>
                                        <RadioButton x:Name="rbStyleSolid" GroupName="CardStyle" Style="{StaticResource CardSegToggle}" Tag="Solid" Content="Solid" Checked="CardStyle_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Title alignment: Left / Center -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="2">
                                        <RadioButton x:Name="rbTitleLeft"   GroupName="TitleAlign" Style="{StaticResource CardSegToggle}" Tag="Left"   Content="Left"   Checked="TitleAlign_Checked"/>
                                        <RadioButton x:Name="rbTitleCenter" GroupName="TitleAlign" Style="{StaticResource CardSegToggle}" Tag="Center" Content="Center" Checked="TitleAlign_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Title vertical placement: Top / Center / Bottom -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vertical" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                        <RadioButton x:Name="rbTitleTop"    GroupName="TitleVAlign" Style="{StaticResource CardSegToggle}" Tag="Top"    Content="Top"    Checked="TitleVAlign_Checked"/>
                                        <RadioButton x:Name="rbTitleMiddle" GroupName="TitleVAlign" Style="{StaticResource CardSegToggle}" Tag="Center" Content="Middle" Checked="TitleVAlign_Checked"/>
                                        <RadioButton x:Name="rbTitleBottom" GroupName="TitleVAlign" Style="{StaticResource CardSegToggle}" Tag="Bottom" Content="Bottom" Checked="TitleVAlign_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Title size -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title size" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                        <RadioButton x:Name="rbTitleSmall" GroupName="TitleSize" Style="{StaticResource CardSegToggle}" Tag="Small"  Content="S" Checked="TitleSize_Checked"/>
                                        <RadioButton x:Name="rbTitleMed"   GroupName="TitleSize" Style="{StaticResource CardSegToggle}" Tag="Medium" Content="M" Checked="TitleSize_Checked"/>
                                        <RadioButton x:Name="rbTitleLarge" GroupName="TitleSize" Style="{StaticResource CardSegToggle}" Tag="Large"  Content="L" Checked="TitleSize_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Game icon shape -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Icon" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                        <RadioButton x:Name="rbIconSquare"  GroupName="IconShape" Style="{StaticResource CardSegToggle}" Tag="Square"  Content="Square" Checked="IconShape_Checked"/>
                                        <RadioButton x:Name="rbIconRounded" GroupName="IconShape" Style="{StaticResource CardSegToggle}" Tag="Rounded" Content="Round"  Checked="IconShape_Checked"/>
                                        <RadioButton x:Name="rbIconCircle"  GroupName="IconShape" Style="{StaticResource CardSegToggle}" Tag="Circle"  Content="Circle" Checked="IconShape_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Card corner roundness -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Corners" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                        <RadioButton x:Name="rbCornerSquare"  GroupName="CardCorner" Style="{StaticResource CardSegToggle}" Tag="Square" Content="Square" Checked="Corner_Checked"/>
                                        <RadioButton x:Name="rbCornerRounded" GroupName="CardCorner" Style="{StaticResource CardSegToggle}" Tag="Round"  Content="Round"  Checked="Corner_Checked"/>
                                        <RadioButton x:Name="rbCornerRound"    GroupName="CardCorner" Style="{StaticResource CardSegToggle}" Tag="Pill"   Content="Pill"   Checked="Corner_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- Card outline thickness -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Outline" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                        <RadioButton x:Name="rbOutlineNone" GroupName="CardOutline" Style="{StaticResource CardSegToggle}" Tag="None" Content="None" Checked="Outline_Checked"/>
                                        <RadioButton x:Name="rbOutlineThin" GroupName="CardOutline" Style="{StaticResource CardSegToggle}" Tag="Thin" Content="Thin" Checked="Outline_Checked"/>
                                        <RadioButton x:Name="rbOutlineBold" GroupName="CardOutline" Style="{StaticResource CardSegToggle}" Tag="Bold" Content="Bold" Checked="Outline_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <!-- How the currently-selected game card is highlighted -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Selected" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" FontSize="12"/>
                                    <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                                        <RadioButton x:Name="rbSelGlow"   GroupName="SelStyle" Style="{StaticResource CardSegToggle}" Tag="Glow"   Content="Glow"   Checked="SelStyle_Checked"/>
                                        <RadioButton x:Name="rbSelBorder" GroupName="SelStyle" Style="{StaticResource CardSegToggle}" Tag="Border" Content="Border" Checked="SelStyle_Checked"/>
                                        <RadioButton x:Name="rbSelBar"    GroupName="SelStyle" Style="{StaticResource CardSegToggle}" Tag="Bar"    Content="Bar"    Checked="SelStyle_Checked"/>
                                        <RadioButton x:Name="rbSelSolid"  GroupName="SelStyle" Style="{StaticResource CardSegToggle}" Tag="Solid"  Content="Solid"  Checked="SelStyle_Checked"/>
                                    </UniformGrid>
                                </Grid>

                                <Border Height="1" Background="#5A6273" Margin="0,12,0,10" Opacity="0.5"/>
                                <CheckBox x:Name="chkSearchBar" Style="{StaticResource ToggleSwitch}" Content="Search bar at top"
                                          Checked="SearchBar_Toggled" Unchecked="SearchBar_Toggled"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- ===== Support / donate popup =====
                         Opened by btnSupport. Clearly states this is a mod, credits + links the
                         original EDI author (NoGRo), then lists user-configurable donation options. -->
                    <Popup x:Name="DonatePopup" PlacementTarget="{Binding ElementName=btnSupport}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="0" VerticalOffset="6" Closed="DonatePopup_Closed">
                        <Border Background="{DynamicResource App.PanelBgHi}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="8" Width="460" Margin="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="#FF000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Gradient header strip -->
                                <Border CornerRadius="7,7,0,0" Padding="14,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E0277A" Offset="0"/>
                                            <GradientStop Color="#7A1E6E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#33FFFFFF" Margin="0,0,11,0">
                                            <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="ClearType"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Support this mod" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"
                                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                            <TextBlock Text="Built on the EDI open-source project" Foreground="#FFE6CDE0" FontSize="11"
                                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="14,12,14,14">
                                    <!-- Mod disclaimer + original-project credit/link, in one box -->
                                    <Border CornerRadius="6" Padding="12,11" Background="#22000000"
                                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource App.Text}"
                                                       FontSize="12" LineHeight="17"
                                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
                                                Unofficial community mod of <Run FontWeight="SemiBold">EDI</Run>. The core device work is by the
                                                original author — donations support this mod's extras, not the upstream project.
                                            </TextBlock>
                                            <Border Height="1" Background="{DynamicResource App.Border}" Opacity="0.6" Margin="0,11,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Original project &#8226; EDI by NoGRo" Foreground="{DynamicResource App.TextMuted}"
                                                               FontSize="11" TextOptions.TextFormattingMode="Ideal"/>
                                                    <TextBlock Text="github.com/NoGRo/Edi" Foreground="{DynamicResource App.AccentAlt}"
                                                               FontWeight="SemiBold" FontSize="12.5" TextOptions.TextFormattingMode="Ideal"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="btnOriginalRepo" Click="OriginalRepo_Click"
                                                        Style="{StaticResource SupportHeaderButton}" Padding="10,0" Height="30"
                                                        ToolTip="Open the original EDI repository on GitHub">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FF74B7"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Visit" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,14,0,12" Opacity="0.6"/>

                                    <!-- Section header -->
                                    <TextBlock Text="WAYS TO SUPPORT" Foreground="{DynamicResource App.TextMuted}" FontSize="11"
                                               FontWeight="SemiBold" Margin="0,0,0,10" TextOptions.TextFormattingMode="Ideal"/>

                                    <!-- DISPLAY mode: one pink button per configured link -->
                                    <StackPanel x:Name="panelDonateView">
                                        <ItemsControl x:Name="icDonate">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DonateLinkButton}" Click="DonationOpen_Click"
                                                            Tag="{Binding Url}" ToolTip="{Binding Url}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="txtNoDonations" TextWrapping="Wrap" Foreground="{DynamicResource App.TextMuted}"
                                                   FontSize="12" Visibility="Collapsed" TextOptions.TextFormattingMode="Ideal"
                                                   Text="No donation options are configured."/>

                                        <!-- Monero (XMR): a receive address shown with a Copy button (no URL to open) -->
                                        <Border x:Name="cardMonero" Margin="0,4,0,0" CornerRadius="6" Padding="10,9"
                                                Background="#22000000" BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#FF6600" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#x0271;" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="ClearType"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Monero (XMR)" Foreground="{DynamicResource App.Text}" FontWeight="SemiBold"
                                                                   FontSize="13" TextOptions.TextFormattingMode="Ideal"/>
                                                        <TextBlock Text="Private crypto &#8226; copy the address and send any amount" Foreground="{DynamicResource App.TextMuted}"
                                                                   FontSize="10.5" TextOptions.TextFormattingMode="Ideal"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Click="MoneroCopy_Click" Style="{StaticResource SupportHeaderButton}"
                                                            Padding="11,0" Height="30" VerticalAlignment="Center" ToolTip="Copy Monero address to clipboard">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF74B7"
                                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="lblMoneroCopy" Text="Copy" VerticalAlignment="Center" FontSize="11" TextOptions.TextFormattingMode="Ideal"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <TextBox x:Name="txtMoneroAddr" IsReadOnly="True" TextWrapping="Wrap" Margin="0,9,0,0" IsTabStop="False"
                                                         Background="#1A1D24" Foreground="{DynamicResource App.TextMuted}"
                                                         BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                                         FontFamily="Consolas" FontSize="11" Padding="7,5"/>
                                                <!-- Scannable QR of the monero: URI; white backing so wallet cameras read it -->
                                                <StackPanel x:Name="qrMoneroPanel" HorizontalAlignment="Center" Margin="0,11,0,2">
                                                    <Border Background="#FFFFFF" CornerRadius="6" Padding="7">
                                                        <Image x:Name="qrMonero" Width="172" Height="172" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                                    </Border>
                                                    <TextBlock Text="Scan with a Monero wallet" Foreground="{DynamicResource App.TextMuted}"
                                                               FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" TextOptions.TextFormattingMode="Ideal"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Left-aligned, drag-reorderable strip: API docs + program launchers + connection chips.
                     All pills are direct children so any can be dragged to any position (handled in code). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="topBar" AllowDrop="True"
                            PreviewMouseLeftButtonDown="TopBar_PreviewMouseDown" PreviewMouseMove="TopBar_PreviewMouseMove"
                            DragOver="TopBar_DragOver" Drop="TopBar_Drop">

                <!-- Swagger / API docs link -->
                <Border x:Name="pillApiDocs" Tag="apidocs" Style="{StaticResource LauncherPill}" Padding="0" Margin="0,0,8,0"
                        ToolTip="Open Swagger API docs in browser"
                        MouseLeftButtonUp="Label_MouseDoubleClick">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" CornerRadius="7,0,0,7" Background="#0E1015">
                            <TextBlock Text="{}{ }" FontFamily="Consolas, Cascadia Mono, monospace" FontWeight="Bold" FontSize="19"
                                       Foreground="{DynamicResource PillIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,7,14,7"
                                    Orientation="{Binding LauncherUrlOrientation, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="API Docs" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource App.AccentAlt}" FontWeight="SemiBold" FontSize="13"
                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="localhost:5000" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text}" FontSize="12"
                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hidden template host: the program-pill DataTemplate below is reused in code
                     (RebuildProgramPills) to create individual pills that drag-reorder with the rest. -->
                <ItemsControl x:Name="programTemplateHost" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LauncherPill}" Padding="0" Margin="0,0,8,0"
                                    MouseLeftButtonUp="QuickProgram_Click"
                                    ToolTip="{Binding Path}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit URL…" Click="EditProgramUrl_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show URL" IsCheckable="True" IsChecked="{Binding ShowUrl, Mode=OneWay}" Click="ToggleProgramUrl_Click">
                                            <MenuItem.Icon><TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Header="Remove" Click="RemoveProgram_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <!-- Full-height icon tile, flush against the left edge -->
                                    <Grid Grid.Column="0" Width="42">
                                        <Border x:Name="exeIcon" CornerRadius="7,0,0,7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Funscript Player"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Intiface"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Converter={StaticResource ProgramIconConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <!-- Funscript Player: a stroke-waveform tile that echoes the live preview line -->
                                        <Border x:Name="fpIcon" CornerRadius="7,0,0,7" Background="#0E1015">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Funscript Player"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Viewbox Margin="9">
                                                <Path StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M0,9 L4,2 L8,14 L12,4 L16,13 L20,8">
                                                    <Path.Stroke>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF74B7" Offset="0"/>
                                                            <GradientStop Color="#FF2D8C" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Path.Stroke>
                                                </Path>
                                            </Viewbox>
                                        </Border>
                                        <!-- Intiface: dark tile + pink Bluetooth glyph -->
                                        <Border x:Name="intifaceIcon" CornerRadius="7,0,0,7" Background="#0E1015">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Intiface"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                       Foreground="{DynamicResource PillIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                        </Border>
                                    </Grid>
                                    <!-- Name on top, optional URL underneath -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,7,14,7"
                                                Orientation="{Binding LauncherUrlOrientation, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource App.AccentAlt}" FontWeight="SemiBold" FontSize="13"
                                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                        <TextBlock Text="{Binding Url}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text}" FontSize="12"
                                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- Collapsed: the pill height is fixed (LauncherPill style), so an absent URL
                                                             just lets the name center vertically — no reserved blank line. -->
                                                        <DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Url}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowUrl}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Connection chips (pinned via the + menu). Click to edit; right-click to remove. -->
                <Border x:Name="chipKey" Tag="chip:Key" Style="{StaticResource LauncherPill}" Padding="0" Margin="0,0,8,0"
                        Visibility="Collapsed" MouseLeftButtonUp="ChipKey_Click" ToolTip="Devices Key — click to edit">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit Device Key…" Click="ChipKeyEdit_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MenuSeparator}"/>
                            <MenuItem Header="Remove" Click="ChipRemove_Click" Tag="Key">
                                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" CornerRadius="7,0,0,7" Background="#0E1015">
                            <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource PillIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,7,14,7" Orientation="{Binding LauncherUrlOrientation, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock x:Name="lblChipKeyLabel" Text="Device Key" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource App.AccentAlt}" FontWeight="SemiBold" FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock x:Name="lblChipKeyVal" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" FontSize="12" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="chipEStim" Tag="chip:EStim" Style="{StaticResource LauncherPill}" Padding="0" Margin="0,0,8,0"
                        Visibility="Collapsed" MouseLeftButtonUp="ChipEStim_Click" ToolTip="EStim Audio device — click to choose">
                    <Border.ContextMenu>
                        <ContextMenu><MenuItem Header="Remove" Click="ChipRemove_Click" Tag="EStim">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                        </MenuItem></ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" CornerRadius="7,0,0,7" Background="#0E1015">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource PillIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,7,14,7" Orientation="{Binding LauncherUrlOrientation, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="EStim" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource App.AccentAlt}" FontWeight="SemiBold" FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock x:Name="lblChipEStimVal" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" FontSize="12" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="chipOSR" Tag="chip:OSR" Style="{StaticResource LauncherPill}" Padding="0" Margin="0,0,8,0"
                        Visibility="Collapsed" MouseLeftButtonUp="ChipOSR_Click" ToolTip="OSR COM port — click to choose">
                    <Border.ContextMenu>
                        <ContextMenu><MenuItem Header="Remove" Click="ChipRemove_Click" Tag="OSR">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                        </MenuItem></ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" CornerRadius="7,0,0,7" Background="#0E1015">
                            <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource PillIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,7,14,7" Orientation="{Binding LauncherUrlOrientation, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="OSR" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource App.AccentAlt}" FontWeight="SemiBold" FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock x:Name="lblChipOSRVal" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" FontSize="12" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Add menu: program or a connection chip (Key / EStim / OSR) -->
                <Button x:Name="btnAddTop" Width="32" Height="32" Click="AddTop_Click" ToolTip="Add to the top bar"
                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="addTopMenu">
                            <MenuItem Header="Add program…" Click="AddProgram_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Intiface" Click="AddIntiface_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Funscript Player" Click="AddFunscriptPlayer_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MenuSeparator}"/>
                            <MenuItem Header="Add Device Key" Click="AddChip_Click" Tag="Key">
                                <MenuItem.Icon><TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Add EStim Audio" Click="AddChip_Click" Tag="EStim">
                                <MenuItem.Icon><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Add OSR Port" Click="AddChip_Click" Tag="OSR">
                                <MenuItem.Icon><TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                </Button>

            </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main content ===== -->
        <Grid Grid.Row="2" Margin="10,10,10,10" x:Name="mainContentGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colGameLeft" Width="0"/>
                <ColumnDefinition x:Name="colGameLeftSplit" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Far-left GAME column: populated (and widened) only when Move-game layout is on -->
            <Grid Grid.Column="0" x:Name="GameLeftSlot"/>
            <GridSplitter Grid.Column="1" x:Name="GameLeftSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" Panel.ZIndex="10" ToolTip="Drag to resize"/>

            <!-- Inner content (Connection / Game / Playback / Options / Info / Preview) -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="colConn" Width="5*" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="colOpts" Width="6*" MinWidth="280"/>
                <ColumnDefinition x:Name="colInfoSpacer" Width="0"/>
                <ColumnDefinition x:Name="colInfo" Width="0"/>
                <ColumnDefinition x:Name="colPreviewSpacer" Width="0"/>
                <ColumnDefinition x:Name="colPreview" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Drag handles to resize the columns -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" Panel.ZIndex="10" ToolTip="Drag to resize"/>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" Panel.ZIndex="10" ToolTip="Drag to resize"/>
            <GridSplitter Grid.Column="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" Panel.ZIndex="10" ToolTip="Drag to resize"/>

            <!-- ============ LEFT COLUMN ============ -->
            <Grid Grid.Column="0" x:Name="LeftStack">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Connection card -->
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="rowGameClassic" Height="Auto"/>  <!-- Game card -->
                    <RowDefinition x:Name="rowGameClassicGap" Height="8"/>
                    <RowDefinition Height="*"/>     <!-- Playback card -->
                </Grid.RowDefinitions>

                <!-- ===== Connection card ===== -->
                <Border Grid.Row="0" x:Name="ConnectionCard" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Section header -->
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="1"/>     <!-- Divider -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <!-- Title now provided by the dock pane caption -->
                        <Label  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="CONNECTION" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource App.Border}" Visibility="Collapsed"/>

                        <!-- Devices Keys -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="18" TextAlignment="Center" Foreground="{DynamicResource App.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Devices Keys" Foreground="{DynamicResource App.Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Grid.Row="4" Grid.Column="1" TextWrapping="NoWrap" ToolTip="Handy, AutoBlow" Text="{Binding handyConfig.Key}" VerticalContentAlignment="Center"/>

                        <!-- Intiface URL -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="18" TextAlignment="Center" Foreground="{DynamicResource App.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Intiface Url" Foreground="{DynamicResource App.Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Grid.Row="6" Grid.Column="1" TextWrapping="NoWrap" Text="{Binding buttplugConfig.Url}" ToolTip="Buttplug Url" VerticalContentAlignment="Center"/>

                        <!-- EStim Audio -->
                        <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="18" TextAlignment="Center" Foreground="{DynamicResource App.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="EStim Audio" Foreground="{DynamicResource App.Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox Grid.Row="8" Grid.Column="1" Name="audioDevicesComboBox" ToolTip="To use E-Stim, you must convert your Funscript files to MP3 format." DisplayMemberPath="name" SelectedValuePath="id" SelectedValue="{Binding estimConfig.DeviceId}" IsTextSearchEnabled="True"/>

                        <!-- OSR Port -->
                        <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="18" TextAlignment="Center" Foreground="{DynamicResource App.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OSR Port" Foreground="{DynamicResource App.Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox Grid.Row="10" Grid.Column="1" Name="comPortsComboBox" DisplayMemberPath="name" SelectedValuePath="value" SelectedValue="{Binding osrConfig.COMPort}" IsTextSearchEnabled="True"/>
                    </Grid>
                </Border>

                <!-- ===== Game card ===== -->
                <Border Grid.Row="2" x:Name="GameCardBorder" Style="{StaticResource Card}">
                  <Grid>
                    <Grid x:Name="GameClassic">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="GAME" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="ReloadButton" Click="ReloadButton_Click" Height="28" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add Game" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Open Config Directory relocated to the top quick-access bar -->
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="GamesComboBox" Height="28"
                                      AlternationCount="2"
                                      SelectedValuePath="Path"
                                      ItemsSource="{Binding gamesConfig.GamesInfo}"
                                      SelectedItem="{Binding gamesConfig.SelectedGameinfo, Mode=TwoWay}"
                                      SelectionChanged="GamesComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="20" Height="20" Margin="0,0,8,0"
                                                   Source="{Binding Converter={StaticResource GameIconConverter}}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Click="ViewButton_Click" ToolTip="Card view options (height &amp; cover blur)" Width="34" Height="28" Margin="0,0,3,0">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <Button x:Name="btnEditGame" Click="btnEditGame_Click" ToolTip="Edit selected game" Width="34" Height="28" Margin="0,0,3,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <Button x:Name="btnRemoveGame" Click="btnRemoveGame_Click" ToolTip="Remove selected game" Width="34" Height="28">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Launch the configured ExePath of the selected game -->
                        <Button Grid.Row="6" x:Name="btnLaunchGame" Click="btnLaunchGame_Click"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Stretch" Height="30"
                                IsEnabled="False"
                                ToolTip="Set the game's .exe path via the gear button to enable">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Launch Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Moved layout: Select Game + buttons row, Launch bar, card list of games. -->
                    <Grid x:Name="GameMoved" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- (No "GAME" header in moved layout — Add Game sits at the top) -->

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="ReloadButton_Click" Height="30" HorizontalAlignment="Stretch"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="+" FontSize="18" FontWeight="Normal"
                                               Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,-2,8,0"/>
                                    <TextBlock Text="ADD GAME" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Width="32" Height="30" Click="ViewButton_Click" ToolTip="Card view options (height &amp; cover blur)" Margin="0,0,6,0"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <Button Width="32" Height="30" Click="btnEditGame_Click" ToolTip="Edit selected game"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <!-- Remove moved to the card right-click menu -->
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="4" x:Name="btnLaunchGameMoved" Click="btnLaunchGame_Click"
                                Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Height="30" IsEnabled="False"
                                SnapsToDevicePixels="True" UseLayoutRounding="True"
                                ToolTip="Set the game's .exe path via the edit button to enable">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LAUNCH GAME" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Row="6">
                            <Label Content="GAMES" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>
                            <!-- Divider above the search bar — sharp/bright (App.BorderStrong) to match the Devices section -->
                            <Border Height="1" Background="{DynamicResource App.BorderStrong}" Margin="0,8,0,8"/>
                            <!-- Optional search bar — sits UNDER the divider (toggled from the eye ▸ Game cards popup) -->
                            <Grid x:Name="searchRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBox x:Name="txtGameSearch" Height="30" VerticalContentAlignment="Center"
                                         Padding="30,2,8,2" TextChanged="GameSearch_TextChanged"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" IsHitTestVisible="False"
                                           Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock Text="Search games…" IsHitTestVisible="False" Foreground="{DynamicResource App.TextDim}"
                                           VerticalAlignment="Center" Margin="30,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=txtGameSearch}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <ListBox Grid.Row="7" x:Name="lstGames" VerticalAlignment="Stretch"
                                 Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding gamesConfig.GamesInfo}"
                                 SelectedItem="{Binding gamesConfig.SelectedGameinfo, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="lstGames_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="lstGames_PreviewMouseMove"
                                 Drop="lstGames_Drop">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="18"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border CornerRadius="3" Background="{DynamicResource App.Accent}" Margin="6,0"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                                        </Track.DecreaseRepeatButton>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <EventSetter Event="MouseEnter" Handler="Card_HoverChanged"/>
                                    <EventSetter Event="MouseLeave" Handler="Card_HoverChanged"/>
                                    <EventSetter Event="Selected"   Handler="Card_SelectionChanged"/>
                                    <EventSetter Event="Unselected" Handler="Card_SelectionChanged"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="cardBd" Background="{DynamicResource App.PanelBgHi}" CornerRadius="{DynamicResource Card.Corner}">
                                                        <!-- Clip the fill/cover (incl. the blur bleed) to a real
                                                             rounded rectangle so the corners stay clean. Radius follows
                                                             the user's "Corners" choice (3rd binding = CardCornerValue). -->
                                                        <Border.Clip>
                                                            <MultiBinding Converter="{StaticResource RoundedClipConverter}">
                                                                <Binding Path="ActualWidth"  RelativeSource="{RelativeSource Self}"/>
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                                <Binding Path="CardCornerValue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </Border.Clip>
                                                        <!-- Fixed height (= the card-height setting) so a video/gif cover
                                                             fills the card on hover instead of ballooning it to the media's
                                                             natural size. -->
                                                        <Grid Height="{DynamicResource Card.MinHeight}">
                                                            <!-- Blurred cover as a BACKGROUND brush so the art never grows
                                                                 the card; it just fills the icon+name height. -->
                                                            <Border x:Name="cover" Opacity="{DynamicResource Card.CoverOpacity}"
                                                                    Visibility="{Binding Converter={StaticResource GameHasCoverConverter}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Converter={StaticResource GameCoverConverter}}"
                                                                                Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                                <Border.Effect>
                                                                    <BlurEffect Radius="{DynamicResource Card.BlurRadius}"/>
                                                                </Border.Effect>
                                                            </Border>
                                                            <!-- Animated (video) cover — only the hovered/selected card plays it -->
                                                            <MediaElement x:Name="vid" Stretch="UniformToFill" Opacity="{DynamicResource Card.CoverOpacity}"
                                                                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                          IsMuted="True" Visibility="Collapsed"
                                                                          MediaEnded="CardVideo_MediaEnded"/>
                                                            <!-- Animated GIF cover — same hover/selection gating -->
                                                            <Image x:Name="gifImg" Stretch="UniformToFill" Opacity="{DynamicResource Card.CoverOpacity}"
                                                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                                                            <!-- Dark scrim so the title stays readable over the art -->
                                                            <Border x:Name="scrim" Background="#FF000000" Opacity="{DynamicResource Card.ScrimOpacity}"
                                                                    Visibility="{Binding Converter={StaticResource GameHasCoverConverter}}"/>
                                                            <ContentPresenter/>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Crisp outline drawn on top (not clipped, so it stays sharp) -->
                                                    <Border x:Name="outline" CornerRadius="{DynamicResource Card.Corner}" BorderThickness="{DynamicResource Card.OutlineThickness}"
                                                            BorderBrush="{DynamicResource App.BorderStrong}" IsHitTestVisible="False"/>
                                                    <!-- Selection overlays (shown only when selected; look set by the "Selected" option). -->
                                                    <Border x:Name="selBar" HorizontalAlignment="Left" Width="{DynamicResource Sel.BarWidth}"
                                                            Background="{DynamicResource App.Accent}" CornerRadius="2" Margin="0,4"
                                                            Visibility="Collapsed" IsHitTestVisible="False"/>
                                                    <Border x:Name="selBorder" CornerRadius="{DynamicResource Card.Corner}"
                                                            BorderThickness="{DynamicResource Sel.BorderThickness}" BorderBrush="{DynamicResource App.Accent}"
                                                            Visibility="Collapsed" IsHitTestVisible="False">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#FF2D8C" ShadowDepth="0"
                                                                              BlurRadius="{DynamicResource Sel.GlowBlur}" Opacity="{DynamicResource Sel.GlowOpacity}"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBd"  Property="Background"  Value="{DynamicResource App.RowHover}"/>
                                                        <Setter TargetName="scrim"   Property="Background"  Value="#8C000000"/>
                                                        <Setter TargetName="outline" Property="BorderBrush" Value="#5A6273"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="selBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="selBar"    Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="cardBd"    Property="Background"  Value="{DynamicResource Sel.FillBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Hide blank/placeholder games (no name) from the card list -->
                                        <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit game…" Click="CardEditGame_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Style="{StaticResource MenuSeparator}"/>
                                                <MenuItem Header="Image">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                    </MenuItem.Icon>
                                                    <MenuItem Header="Crop image…" Click="CardCropImage_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE123;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource MenuSeparator}"/>
                                                    <MenuItem Header="Set image from file…" Click="CardSetImageFile_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Set image from URL…" Click="CardSetImageUrl_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Fetch cover (DLsite / F95)" Click="CardFetchCover_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource MenuSeparator}"/>
                                                    <MenuItem Header="Clear image" Click="CardClearImage_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuItem>
                                                <Separator Style="{StaticResource MenuSeparator}"/>
                                                <MenuItem Header="Remove game" Click="CardRemoveGame_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF5C7A"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>   <!-- icon (square, = card height) -->
                                            <ColumnDefinition Width="Auto"/>   <!-- divider -->
                                            <ColumnDefinition Width="*"/>      <!-- title -->
                                            <ColumnDefinition Width="Auto"/>   <!-- type badge -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon: flush to the left edge, square and as tall as the card
                                             (scales when you change card height in Settings). -->
                                        <Border Grid.Column="0" CornerRadius="{DynamicResource Card.IconRadius}" Margin="{DynamicResource Card.IconMargin}"
                                                Width="{DynamicResource Card.IconSize}" Height="{DynamicResource Card.IconSize}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Converter={StaticResource GameIconConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- Spacing between icon and title -->
                                        <Border Grid.Column="1" Width="1" Background="Transparent" Margin="9,8"/>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="{DynamicResource Card.TitleVAlign}"
                                                   Margin="0,5,8,5" Foreground="#FFFFFF"
                                                   FontSize="{DynamicResource Card.TitleSize}" FontWeight="SemiBold"
                                                   TextAlignment="{DynamicResource Card.TitleAlign}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextOptions.TextRenderingMode="ClearType">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="1.2" Direction="270" Opacity="0.75" Color="#000000"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <!-- Type badge: a colored chip showing the platform (EDI / Script Player) -->
                                        <Border Grid.Column="3" CornerRadius="{DynamicResource Card.BadgeRadius}" BorderThickness="1" Padding="9,3"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"  Value="{DynamicResource App.AccentSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                                    <Setter Property="ToolTip"     Value="EDI game"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GameType}" Value="ScriptPlayer">
                                                            <Setter Property="Background"  Value="#14233D"/>
                                                            <Setter Property="BorderBrush" Value="#4D93FF"/>
                                                            <Setter Property="ToolTip"     Value="Script Player game"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"       Value="&#xE7FC;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GameType}" Value="ScriptPlayer">
                                                                    <Setter Property="Text"       Value="&#xE714;"/>
                                                                    <Setter Property="Foreground" Value="#4D93FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="EDI"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GameType}" Value="ScriptPlayer">
                                                                    <Setter Property="Text" Value="Script"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                  </Grid>
                </Border>

                <!-- ===== Live Edit card (intensity — own dock window) ===== -->
                <Border Grid.Row="4" x:Name="LiveEditCard" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Intensity: stroke amplitude. Past 100% overdrives (saturates high). -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{DynamicResource App.Accent}"
                                           TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                <TextBlock Text="INTENSITY" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Accent}" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="sliderIntensity" Style="{StaticResource IntensitySlider}"
                                    Value="100" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"
                                    ToolTip="Stroke intensity — scales the stroke range (100% = full scripted range). Click or drag the handle."/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{DynamicResource App.Text}"
                                       Text="{Binding Value, ElementName=sliderIntensity, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <!-- Vibration: strength for vibrating / oscillating devices (Buttplug). Cyan to match its label. -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{DynamicResource App.AccentAlt}"
                                           TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                <TextBlock Text="VIBRATION" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.AccentAlt}" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="sliderVibration" Style="{StaticResource IntensitySlider}"
                                    Value="100" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Vibration_ValueChanged"
                                    ToolTip="Vibration strength for vibrating / oscillating devices. Click or drag the handle.">
                                <Slider.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00A6B8" Offset="0"/>
                                        <GradientStop Color="#00E5FF" Offset="0.55"/>
                                        <GradientStop Color="#7DF3FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Foreground>
                            </Slider>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{DynamicResource App.Text}"
                                       Text="{Binding Value, ElementName=sliderVibration, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <!-- Rotary fuck-machine converter: turn a stroke script into a power-level variant -->
                        <Button Grid.Row="2" x:Name="btnFmConverter" Click="FmConverter_Click" Margin="0,10,0,0"
                                Height="32" HorizontalAlignment="Stretch"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                ToolTip="Convert a stroke funscript into a rotary fuck-machine power-level variant (saves a new variant; original untouched)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#x27F3;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Accent}"/>
                                <TextBlock Text="Fuck Machine converter" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Playback card (live preview + transport + modify — own dock window) ===== -->
                <Border Grid.Row="4" x:Name="PlaybackCard" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <local:FunscriptPreview x:Name="funscriptPreview" Grid.Row="0"/>

                        <!-- Transport row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="cmbGallerie" Height="34" VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      DisplayMemberPath="Name" ItemsSource="{Binding galleries}"
                                      AlternationCount="2">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource App.RowHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource App.RowSelect}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource App.RowAlt}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="5" Background="{DynamicResource App.Accent}" Margin="2,0"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                                            </Track.IncreaseRepeatButton>
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                                            </Track.DecreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Style="{StaticResource TransportButton}" ToolTip="Play"           x:Name="btnPlay"      Click="btnPlay_Click">
                                    <TextBlock Text="▶" FontSize="16" Foreground="{DynamicResource App.Accent}"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" ToolTip="Stop"           x:Name="btnStop"      Click="btnStop_Click">
                                    <TextBlock Text="■" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" ToolTip="Pause"          x:Name="btnPause"     Click="btnPause_Click">
                                    <TextBlock Text="❚❚" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" ToolTip="Resume"         x:Name="btnResume"    Click="btnResume_Click">
                                    <TextBlock Text="►❚❚" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" ToolTip="Action Preview" x:Name="btnSimulator" Click="btnSimulator_Click">
                                    <TextBlock Text="👁" FontSize="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Modify Scripts (opens the Funscript editor) -->
                        <Button Grid.Row="4" x:Name="btnFunscriptEditor" Click="btnFunscriptEditor_Click"
                                Style="{StaticResource BlueButton}" Height="36" HorizontalAlignment="Stretch"
                                ToolTip="Edit / modify the gallery's funscripts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Modify Scripts" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Log card (playback log — own dock window) ===== -->
                <Border Grid.Row="4" x:Name="LogCard" Style="{StaticResource Card}">
                    <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto" Padding="8,6">
                        <ItemsControl x:Name="logList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Newest line sits on top with an accent pill + dot; older lines dim below. -->
                                    <Border CornerRadius="4" Padding="7,3" Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="#22FF3D93"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource App.Accent}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource App.TextDim}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- ===== Fuck Machine converter (hosted in a dockable optional panel) ===== -->
                <local:FmConverterControl Grid.Row="4" x:Name="FmConverterCard" Visibility="Collapsed"/>
            </Grid>

            <!-- ============ RIGHT COLUMN ============ -->
            <Border Grid.Column="2" x:Name="OptionsCard" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 0 OPTIONS header -->
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="1"/>      <!-- 2 Divider -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>   <!-- 4 Toggle row + settings button -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="1"/>      <!-- 6 Divider under toggles -->
                        <RowDefinition Height="Auto"/>   <!-- 7 Inline settings panel (collapsible) -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>   <!-- 9 DEVICES header + Reconnect -->
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="1"/>      <!-- 11 Divider -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>      <!-- 13 Devices grid -->
                    </Grid.RowDefinitions>

                    <Label  Grid.Row="0" Content="OPTIONS" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>
                    <Border Grid.Row="2" Height="1" Background="{DynamicResource App.Border}" Visibility="Collapsed"/>

                    <!-- Toggles + Reconnect. Reconnect sits to the right when there's room; if it would
                         collide with the toggles it drops to a full-width row underneath (handled in code). -->
                    <Grid Grid.Row="4" x:Name="devActionRow" SizeChanged="DevActionRow_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="devToggles" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Filler"   Margin="0,0,18,0" x:Name="chkFiller"   IsChecked="{Binding config.Filler, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Gallery"  Margin="0,0,18,0" x:Name="chkGallery"  IsChecked="{Binding config.Gallery, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Reaction"                   x:Name="chkReaction" IsChecked="{Binding config.Reactive, Mode=TwoWay}"/>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="ReconnectButton" Click="ReconnectButton_ClickAsync" Height="30" Width="148"
                                VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Reconnect devices">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Reconnect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="6" Height="1" Background="{DynamicResource App.Border}"/>

                    <!-- Settings popup (opened by the Settings button) -->
                    <Popup x:Name="SettingsPopup" Grid.Row="7"
                           PlacementTarget="{Binding ElementName=btnSettings}"
                           Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="0" VerticalOffset="4">
                        <Border Background="{DynamicResource App.PanelBgHi}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Width="330" Margin="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="#FF000000"/>
                            </Border.Effect>
                        <StackPanel>
                          <StackPanel.Resources>
                              <!-- Small circular "i" that opens a themed help popup (replaces inline blurbs) -->
                              <Style x:Key="InfoDot" TargetType="ToggleButton">
                                  <Setter Property="Width" Value="18"/>
                                  <Setter Property="Height" Value="18"/>
                                  <Setter Property="Cursor" Value="Hand"/>
                                  <Setter Property="VerticalAlignment" Value="Center"/>
                                  <Setter Property="ToolTip" Value="What's this?"/>
                                  <Setter Property="Template">
                                      <Setter.Value>
                                          <ControlTemplate TargetType="ToggleButton">
                                              <Border x:Name="b" CornerRadius="9" BorderThickness="1.2"
                                                      BorderBrush="{DynamicResource App.AccentAlt}" Background="Transparent">
                                                  <TextBlock Text="i" FontStyle="Italic" FontWeight="Bold" FontSize="11"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource App.AccentAlt}" TextOptions.TextFormattingMode="Ideal"/>
                                              </Border>
                                              <ControlTemplate.Triggers>
                                                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FF3D93"/></Trigger>
                                                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#33FF3D93"/></Trigger>
                                              </ControlTemplate.Triggers>
                                          </ControlTemplate>
                                      </Setter.Value>
                                  </Setter>
                              </Style>
                              <Style x:Key="InfoPopupCard" TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource App.PanelBgHi}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                                  <Setter Property="BorderThickness" Value="1"/>
                                  <Setter Property="CornerRadius" Value="6"/>
                                  <Setter Property="Padding" Value="11,9"/>
                                  <Setter Property="MaxWidth" Value="300"/>
                                  <Setter Property="Margin" Value="0,4,8,8"/>
                                  <Setter Property="Effect">
                                      <Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="#FF000000"/></Setter.Value>
                                  </Setter>
                              </Style>
                              <Style x:Key="InfoPopupText" TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
                                  <Setter Property="FontSize" Value="11.5"/>
                                  <Setter Property="TextWrapping" Value="Wrap"/>
                                  <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                              </Style>
                          </StackPanel.Resources>
                          <TabControl Style="{StaticResource SettingsTabs}">
                            <!-- ===== Data tab ===== -->
                            <TabItem Header="Data" Style="{StaticResource SettingsTabItem}">
                              <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="chkCustomSaveLoc" Style="{StaticResource ToggleSwitch}"
                                              Content="Custom save-data location" VerticalAlignment="Center"
                                              Checked="CustomSaveLoc_Toggled" Unchecked="CustomSaveLoc_Toggled"/>
                                    <ToggleButton Grid.Column="1" x:Name="infoSaveLoc" Style="{StaticResource InfoDot}"/>
                                    <Popup PlacementTarget="{Binding ElementName=infoSaveLoc}" Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=infoSaveLoc}">
                                        <Border Style="{StaticResource InfoPopupCard}">
                                            <TextBlock Style="{StaticResource InfoPopupText}"
                                                       Text="Where EDI keeps its data (config, recordings, bundles). Default: %LocalAppData%\Edi"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtSaveLoc" Height="30" VerticalContentAlignment="Center" IsEnabled="False"/>
                                    <Button  Grid.Column="2" x:Name="btnBrowseSaveLoc" Content="Browse…" Height="30" Width="84" IsEnabled="False" Click="BrowseSaveLoc_Click"
                                             BorderBrush="{DynamicResource App.Border}" BorderThickness="1"/>
                                </Grid>
                                <Border Height="1" Background="#5A6273" Margin="0,14,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Games Location  ·  EDI / Script Player" Foreground="{DynamicResource App.Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" x:Name="infoGameLoc" Style="{StaticResource InfoDot}"/>
                                    <Popup PlacementTarget="{Binding ElementName=infoGameLoc}" Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=infoGameLoc}">
                                        <Border Style="{StaticResource InfoPopupCard}">
                                            <TextBlock Style="{StaticResource InfoPopupText}"
                                                       Text="Root folder holding your EDI and Script Player games. A game inside it shows that folder's custom icon on its card; each game's EDI/Script Player type is set when you add or edit it."/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtGameFolder" Height="30" VerticalContentAlignment="Center"/>
                                    <Button  Grid.Column="2" x:Name="btnBrowseGameFolder" Content="Browse…" Height="30" Width="84" Click="BrowseGameFolder_Click"
                                             BorderBrush="{DynamicResource App.Border}" BorderThickness="1"/>
                                </Grid>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="Root folder holding your EDI and Script Player games. A game inside it shows that folder's custom icon on its card; each game's EDI/Script Player type is set when you add or edit it."/>
                                </Border>

                                <!-- Auto mode: scan the folder above and add every set-up game at once -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="btnAutoAddGames" Height="34" HorizontalAlignment="Stretch"
                                            Click="AutoAddGames_Click" Style="{StaticResource AccentButton}"
                                            ToolTip="Scan the Games Location and add every game that has an EdiConfig.json, auto-detecting its files">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Auto-add all games from this folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton Grid.Column="1" x:Name="infoAutoAdd" Style="{StaticResource InfoDot}" Margin="8,0,0,0"/>
                                    <Popup PlacementTarget="{Binding ElementName=infoAutoAdd}" Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=infoAutoAdd}">
                                        <Border Style="{StaticResource InfoPopupCard}">
                                            <TextBlock Style="{StaticResource InfoPopupText}"
                                                       Text="Scans every folder here and adds the ones that already contain an EdiConfig.json — guessing each game's executable, gallery/scripts, info doc and type. Skips games already in your list."/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Border Height="1" Background="#5A6273" Margin="0,14,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Funscript Player Location" Foreground="{DynamicResource App.Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" x:Name="infoFunscriptPlayer" Style="{StaticResource InfoDot}"/>
                                    <Popup PlacementTarget="{Binding ElementName=infoFunscriptPlayer}" Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=infoFunscriptPlayer}">
                                        <Border Style="{StaticResource InfoPopupCard}">
                                            <TextBlock Style="{StaticResource InfoPopupText}"
                                                       Text="The funscript player (ScriptPlayer, MultiFunPlayer…) Script Player games launch through. Their scripts default to a .\Scripts folder next to it."/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtFunscriptPlayer" Height="30" VerticalContentAlignment="Center"/>
                                    <Button  Grid.Column="2" x:Name="btnBrowseFunscriptPlayer" Content="Browse…" Height="30" Width="84" Click="BrowseFunscriptPlayer_Click"
                                             BorderBrush="{DynamicResource App.Border}" BorderThickness="1"/>
                                </Grid>

                                <Border Height="1" Background="#5A6273" Margin="0,14,0,10"/>

                                <!-- SteamGridDB API key — enables steamgriddb.com as a cover/banner source -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SteamGridDB cover art" Foreground="{DynamicResource App.Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" x:Name="infoSteamGrid" Style="{StaticResource InfoDot}"/>
                                    <Popup PlacementTarget="{Binding ElementName=infoSteamGrid}" Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=infoSteamGrid}">
                                        <Border Style="{StaticResource InfoPopupCard}">
                                            <TextBlock Style="{StaticResource InfoPopupText}"
                                                       Text="Adds steamgriddb.com as a cover/banner source in the cover search. Paste your free API key (steamgriddb.com → profile → Preferences → API). When set, its results show first."/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtSteamGridKey" Height="30" VerticalContentAlignment="Center"
                                             ToolTip="Paste your SteamGridDB API key"/>
                                    <Button  Grid.Column="2" Content="Get key" Height="30" Width="84" Click="SteamGridGetKey_Click"
                                             BorderBrush="{DynamicResource App.Border}" BorderThickness="1" ToolTip="Open steamgriddb.com to create a free API key"/>
                                </Grid>
                              </StackPanel>
                            </TabItem>

                            <!-- ===== Display tab ===== -->
                            <TabItem Header="Display" Style="{StaticResource SettingsTabItem}">
                              <StackPanel>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <CheckBox x:Name="chkPreviewInMain" Style="{StaticResource ToggleSwitch}"
                                                  Content="Show preview in main window" FontSize="13" FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,8,0,0"
                                                   Text="The eye (Action Preview) docks inside EDI instead of opening its own window."/>
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="#5A6273" Margin="0,12,0,10"/>

                                <CheckBox x:Name="chkMoveGame" Style="{StaticResource ToggleSwitch}"
                                          Content="Move game layout" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="Show games as a clickable card list, with Select Game + Launch above (instead of the dropdown)."/>
                                </Border>

                                <Border Height="1" Background="#5A6273" Margin="0,12,0,10"/>

                                <CheckBox x:Name="chkShowInfo" Style="{StaticResource ToggleSwitch}"
                                          Content="Info" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="When on, the Info panel shows to the right of Options only if the selected game has an info file (its Info Location, or an Info.txt / .md / .pdf next to Edi.exe). Games without one show nothing."/>
                                </Border>

                                <Border Height="1" Background="#5A6273" Margin="0,12,0,10"/>

                                <CheckBox x:Name="chkStackLauncher" Style="{StaticResource ToggleSwitch}"
                                          Content="Stack launcher URL under name" VerticalAlignment="Center"
                                          Checked="StackLauncher_Toggled" Unchecked="StackLauncher_Toggled"/>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="On: the API Docs / Intiface pills show their URL on a second line under the name. Off: URL sits beside the name."/>
                                </Border>

                              </StackPanel>
                            </TabItem>

                            <!-- ===== Panels tab ===== -->
                            <TabItem Header="Panels" Style="{StaticResource SettingsTabItem}">
                              <StackPanel>
                                <CheckBox x:Name="chkPanelConnection" Style="{StaticResource ToggleSwitch}" Content="Legacy Connection" Margin="0,0,0,5"
                                          Tag="connection" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"/>
                                <CheckBox x:Name="chkPanelGame" Style="{StaticResource ToggleSwitch}" Content="Game" Margin="0,0,0,5"
                                          Tag="game" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"/>
                                <CheckBox x:Name="chkPanelPlayback" Style="{StaticResource ToggleSwitch}" Content="Playback" Margin="0,0,0,5"
                                          Tag="playback" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"/>
                                <CheckBox x:Name="chkPanelLiveEdit" Style="{StaticResource ToggleSwitch}" Content="Live Edit" Margin="0,0,0,5"
                                          Tag="liveedit" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"/>
                                <CheckBox x:Name="chkPanelLog" Style="{StaticResource ToggleSwitch}" Content="Log" Margin="0,0,0,5"
                                          Tag="log" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"/>
                                <CheckBox x:Name="chkPanelOptions" Style="{StaticResource ToggleSwitch}" Content="Devices" Margin="0,0,0,5"
                                          Tag="options" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"/>
                                <CheckBox x:Name="chkPanelFm" Style="{StaticResource ToggleSwitch}" Content="FM Converter"
                                          Tag="fmconverter" Checked="PanelToggle_Toggled" Unchecked="PanelToggle_Toggled"
                                          ToolTip="Show the rotary fuck-machine script converter in its own window"/>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="Show or hide each dock panel. Hidden panels can be brought back here anytime."/>
                                </Border>
                              </StackPanel>
                            </TabItem>

                            <!-- ===== Dev tab ===== -->
                            <TabItem Header="Dev" Style="{StaticResource SettingsTabItem}">
                              <StackPanel>
                                <CheckBox x:Name="chkPreviewDevice" Style="{StaticResource ToggleSwitch}" Content="Preview device"
                                          VerticalAlignment="Center"
                                          Checked="PreviewDevice_Toggled" Unchecked="PreviewDevice_Toggled"/>
                                <Border Background="{DynamicResource App.PanelBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource App.TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="Loads a hidden 'Preview Device' so the Playback panel can visualize the live script. It also shows up in EDI's API device list / to in-game mods — turn this OFF if it interferes with a game's integration."/>
                                </Border>
                              </StackPanel>
                            </TabItem>
                          </TabControl>

                          <Button x:Name="btnSettingsSave" Content="Save" Height="28" Width="84"
                                  HorizontalAlignment="Right" Margin="0,12,0,0" Click="SettingsSave_Click"/>
                        </StackPanel>
                        </Border>
                    </Popup>

                    <!-- DEVICES header + Reconnect moved up into the toggles row; pane title is "Devices". -->

                    <DataGrid Grid.Row="13" x:Name="DevicesGrid" ItemsSource="{Binding devices}" AutoGenerateColumns="False" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Selected Variant" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="Variants" ItemsSource="{Binding Variants}" SelectionChanged="Variants_SelectionChanged" SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ready" FontFamily="Segoe UI Emoji" FontSize="14" Binding="{Binding IsReady, Converter={StaticResource BoolToReadyIconConverter}, Mode=OneWay}" Width="64"/>
                            <DataGridTemplateColumn Header="Channel" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="Channels"
                                  ItemsSource="{Binding DataContext.channels, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectionChanged="Channels_SelectionChanged"
                                  SelectedValue="{Binding Channel, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty-state message shown when no devices are connected -->
                    <TextBlock Grid.Row="13" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource App.TextMuted}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Margin="20,40,20,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=DevicesGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource App.Accent}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="No devices connected yet."/>
                        <LineBreak/>
                        <Run Text="Connect one (Intiface / EStim / OSR), then press Reconnect." Foreground="{DynamicResource App.TextDim}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ============ INFO COLUMN (toggled by Add Info Tab) ============ -->
            <Border Grid.Column="4" x:Name="InfoCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel LastChildFill="False">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label  Grid.Column="0" Content="INFO" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button Grid.Column="1" x:Name="btnInfoOpen" Content="Open PDF" Height="24" Width="84"
                                Click="InfoOpen_Click" Visibility="Collapsed"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource App.Border}" Margin="0,4,0,8" Visibility="Collapsed"/>
                    <!-- Content box: info icon | divider | centered text. Sits at top, hugs its
                         content; caps at the column height and scrolls only if the text is long.
                         The icon + vertical divider only show in the placeholder (no file) state. -->
                    <Border DockPanel.Dock="Top" VerticalAlignment="Top"
                            MaxHeight="{Binding ActualHeight, ElementName=InfoCard}"
                            Background="{DynamicResource App.PanelBgHi}"
                            BorderBrush="#5A6273" BorderThickness="1"
                            CornerRadius="6" Padding="12,10">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="infoIcon" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="22" Foreground="{DynamicResource App.Accent}"
                                       VerticalAlignment="Center" Margin="2,0,12,0"/>
                            <Border x:Name="infoVDivider" DockPanel.Dock="Left" Width="1" Background="#5A6273" Margin="0,2,12,2"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="txtInfoContent" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="2,0,10,0"
                                           Foreground="{DynamicResource App.Text}" FontSize="12"
                                           Text="No info file found."/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- LIVE SCRIPT PREVIEW now lives inside the PLAYBACK card (center area),
                 wired up in code-behind (ShowEmbeddedPreview). This column is unused. -->
            </Grid>
        </Grid>

        <!-- ===== Dockable layout (panels are injected from the cards above in code) ===== -->
        <avalonDock:DockingManager x:Name="dockManager" Grid.Row="2" Margin="8,8,8,8"
                                   Background="{DynamicResource App.WindowBg}"
                                   AllowMixedOrientation="True">
            <!-- Recolor the VS2013 theme's blue pane chrome to EDI pink (active pane title bar
                 = the draggable caption, plus its caption buttons' hover/press states). -->
            <avalonDock:DockingManager.Resources>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionActiveBackground}" Color="#FF2D8C"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionButtonActiveHoveredBackground}" Color="#FF74B7"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionButtonActiveHoveredBorder}" Color="#FF74B7"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionButtonActivePressedBackground}" Color="#FFB81E6B"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionButtonActivePressedBorder}" Color="#FFB81E6B"/>
                <!-- Caption (pane title) text: white on the active pink bar, light gray when inactive.
                     Hide the dotted drag-grip that fills the caption (it reads as clutter / cut-off text). -->
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionActiveText}" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionInactiveText}" Color="#FFC7CCD6"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionActiveGrip}" Color="#00000000"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowCaptionInactiveGrip}" Color="#00000000"/>
                <!-- Pane tabs (PLAYBACK / Log / Devices / Live Edit): clearer, on-brand states.
                     Selected (active) = filled pink pill + white text; selected (inactive) = raised
                     slate + light text; unselected = muted gray; hover = light pink. -->
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabSelectedActiveBackground}" Color="#FF2D8C"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabSelectedActiveText}" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabSelectedInactiveBackground}" Color="#FF3A4150"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabSelectedInactiveText}" Color="#FFE6E9F0"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabUnselectedText}" Color="#FFD6DAE2"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabUnselectedHoveredText}" Color="#FF74B7"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adkeys:ResourceKeys}, ResourceId=ToolWindowTabUnselectedHoveredBackground}" Color="#FF2A3142"/>

                <!-- Bigger pane tabs (Playback / Log / Devices) with the title inset from the edges so it
                     never crowds the selected-tab fill. Full template so size/padding are ours to set. -->
                <Style TargetType="{x:Type avalonDock:LayoutAnchorableTabItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type avalonDock:LayoutAnchorableTabItem}">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6,6,0,0"
                                        Margin="2,3,0,0" Padding="14,8" SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="tabIco" Source="{Binding Model.IconSource, RelativeSource={RelativeSource TemplatedParent}}"
                                               Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" SnapsToDevicePixels="True" Opacity="0.9"/>
                                        <TextBlock x:Name="txt" Text="{Binding Model.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="#FFD6DAE2" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd"  Property="Background" Value="#FF333B4B"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#FFFFFFFF"/>
                                        <Setter TargetName="tabIco" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Model.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                        <Setter TargetName="bd"  Property="Background" Value="#FF2D8C"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#FFFFFFFF"/>
                                        <Setter TargetName="txt" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1.2" Direction="270" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="tabIco" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1.2" Direction="270" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="tabIco" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </avalonDock:DockingManager.Resources>
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="1.5*">
                        <avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorable x:Name="anchConnection" Title="Legacy Connection" ContentId="connection" CanClose="False" CanHide="True"/>
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorable x:Name="anchGame" Title="GAME" ContentId="game" CanClose="False" CanHide="True"/>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>
                    <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="2*">
                        <avalonDock:LayoutAnchorablePane DockHeight="3*">
                            <avalonDock:LayoutAnchorable x:Name="anchPlayback" Title="Playback" ContentId="playback" CanClose="False" CanHide="True"/>
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane DockHeight="1*">
                            <avalonDock:LayoutAnchorable x:Name="anchLiveEdit" Title="Live Edit" ContentId="liveedit" CanClose="False" CanHide="True"/>
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane DockHeight="2*">
                            <avalonDock:LayoutAnchorable x:Name="anchLog" Title="Log" ContentId="log" CanClose="False" CanHide="True"/>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>
                    <avalonDock:LayoutAnchorablePane DockWidth="1.5*">
                        <avalonDock:LayoutAnchorable x:Name="anchOptions" Title="Devices" ContentId="options" CanClose="False" CanHide="True"/>
                        <avalonDock:LayoutAnchorable x:Name="anchInfo" Title="INFO" ContentId="info" CanClose="False" CanHide="True"/>
                        <avalonDock:LayoutAnchorable x:Name="anchFm" Title="FM Converter" ContentId="fmconverter" CanClose="False" CanHide="True"/>
                    </avalonDock:LayoutAnchorablePane>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- ===== Bottom status bar ===== -->
        <Border Grid.Row="3" Background="{DynamicResource App.HeaderBg}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="14,6">
            <Label x:Name="lblStatus" Content="Status:" Foreground="{DynamicResource App.TextMuted}" Padding="0"/>
        </Border>
    </Grid>
</Window>
