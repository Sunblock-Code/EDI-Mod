<UserControl x:Class="Edi.Forms.FunscriptPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#0E1015" CornerRadius="4" ClipToBounds="True"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Grid>
            <!-- reference grid lines (top / mid / bottom) -->
            <Canvas x:Name="gridCanvas" IsHitTestVisible="False"/>

            <!-- the funscript line + playhead + live dot -->
            <Canvas x:Name="canvas" Background="Transparent" ClipToBounds="True">
                <Polyline x:Name="linePoly" StrokeThickness="2" StrokeLineJoin="Round">
                    <Polyline.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF74B7" Offset="0"/>
                            <GradientStop Color="#FF2D8C" Offset="1"/>
                        </LinearGradientBrush>
                    </Polyline.Stroke>
                    <Polyline.Effect>
                        <DropShadowEffect Color="#FF2D8C" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                    </Polyline.Effect>
                </Polyline>
                <Line x:Name="playhead" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.8" Visibility="Collapsed"/>
                <Ellipse x:Name="dot" Width="11" Height="11" Fill="#FFFFFF" Stroke="#FF2D8C" StrokeThickness="2"
                         Visibility="Collapsed">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF2D8C" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- current script name (flashes briefly when EDI swaps) -->
            <Border x:Name="nameChip" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6"
                    Background="#B3000000" CornerRadius="3" Padding="6,2">
                <TextBlock x:Name="lblName" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
            </Border>

            <!-- Empty state: pink-outlined pill matching the rest of the app's accent. Trailing dots animate. -->
            <Border x:Name="lblEmpty" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6"
                    Background="#B3000000" CornerRadius="3" Padding="8,4"
                    BorderBrush="{DynamicResource App.Accent}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Waiting for playback" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center"/>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Width="18" TextAlignment="Left"
                               Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Duration="0:0:1.4">
                                            <DiscreteStringKeyFrame Value="" KeyTime="0:0:0"/>
                                            <DiscreteStringKeyFrame Value="." KeyTime="0:0:0.35"/>
                                            <DiscreteStringKeyFrame Value=".." KeyTime="0:0:0.70"/>
                                            <DiscreteStringKeyFrame Value="..." KeyTime="0:0:1.05"/>
                                        </StringAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Demo toggle: animate a synthetic script so the preview can be tested with no device -->
            <Button x:Name="btnDemo" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6"
                    Content="▶ Test pattern" FontSize="11" Foreground="#FFFFFF" Cursor="Hand"
                    Click="Demo_Click" ToolTip="Play a synthetic funscript to preview this without a device">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#B3000000" CornerRadius="3" Padding="8,3"
                                BorderBrush="#3AFFFFFF" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CC2D2F3A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF2D8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
